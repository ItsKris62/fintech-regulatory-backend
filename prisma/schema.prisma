  name         String
  domain       String?   @unique
  industry     String?
  regulatorMix String[]  @default([])
  notes        String?
  createdById  String
  createdBy    User      @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  contacts     Contact[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
