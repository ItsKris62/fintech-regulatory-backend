  payload          Json
  progress         Int       @default(0)
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3)
  priority         Int       @default(0)
  runAfter         DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  lastError        String?
  deadLetteredAt   DateTime?
