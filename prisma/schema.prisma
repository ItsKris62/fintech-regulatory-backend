  updatedBy    User?        @relation("LicenseFeeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([organizationId])
  @@index([dueDate])
  @@index([status])
}

model VaultDocument {
  id             String              @id @default(cuid())
  name           String
  description    String?
  fileName       String
  fileType       String
  fileExtension  String
  fileSize       Int
  storageKey     String
  category       DocumentCategory
  status         VaultDocumentStatus @default(PENDING)
  expiryDate     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  uploadedById   String
  organizationId String
  tags           String[]            @default([])
  version        Int                 @default(1)
  isArchived     Boolean             @default(false)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // B3 additions (2026-05-12 - DPA/forensic hardening):
  // - r2Bucket: explicit bucket name; supports future bucket migrations
  // - contentHash: SHA-256 hex; populated by B4 confirm, used for tamper detection
  // - encryptionKeyId: reserved for DPA sprint's envelope encryption (KMS)
  // - uploadStatus: lifecycle state; orthogonal to business status
  // - retentionExpiresAt: set by DPA sprint's RetentionPolicy resolver
  // - deletedAt: soft delete; queries should filter WHERE deletedAt IS NULL
  r2Bucket           String?
  contentHash        String?
  encryptionKeyId    String?
  uploadStatus       VaultDocumentUploadStatus?
  retentionExpiresAt DateTime?
  deletedAt          DateTime?

  uploadedBy                    User                   @relation(fields: [uploadedById], references: [id])
  organization                  Organization           @relation(fields: [organizationId], references: [id])
  licenseDocuments              LicenseDocument[]      @relation("LicenseDocumentVaultDocument")
  licenseTimelineEvidenceEvents LicenseTimelineEvent[] @relation("LicenseTimelineEvidenceDocument")

  @@index([organizationId])
  @@index([uploadedById])
  @@index([category])
  @@index([status])
  @@index([organizationId, category])
  @@index([organizationId, status])
}

model RegulatoryFramework {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  category             String
  description          String?
  tier                 String                 @default("STARTUP")
