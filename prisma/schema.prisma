generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                String                           @id @default(cuid())
  supabaseAuthId                    String?                          @unique
  email                             String                           @unique
  password                          String? // nullable - Supabase is the authoritative credential store
  fullName                          String
  phone                             String?
  avatar                            String?
  role                              UserRole
  status                            UserStatus                       @default(PENDING_VERIFICATION)
  accountStatus                     String                           @default("pending") // "pending" | "active" | "suspended" | "rejected" | "pending_approval"
  emailVerified                     Boolean                          @default(false)
  emailVerifiedAt                   DateTime?
  emailVerificationToken            String?                          @unique
  emailVerificationExpiry           DateTime?
  passwordResetToken                String?                          @unique
  passwordResetExpiry               DateTime?
  mustChangePassword                Boolean                          @default(false)
  temporaryPasswordExpiresAt        DateTime?
  temporaryPasswordIssuedAt         DateTime?
  temporaryPasswordUsedAt           DateTime?
  temporaryPasswordCreatedByAdminId String?
  temporaryPasswordDeliveryStatus   String?
  temporaryPasswordVersion          Int                              @default(0)
  organizationId                    String?
  lastLoginAt                       DateTime?
  lastLoginIp                       String?
  createdAt                         DateTime                         @default(now())
  updatedAt                         DateTime                         @updatedAt
  deletedAt                         DateTime? // Soft delete timestamp - null means active
  preferences                       Json?
  totpEnabled                       Boolean                          @default(false)
  totpSecret                        String?
  apiKeys                           ApiKey[]
  auditLogs                         AuditLog[]
  checklists                        Checklist[]
  gapAnalyses                       GapAnalysis[]
  complianceQueries                 ComplianceQuery[]
  authoredDocuments                 LegalDocument[]                  @relation("DocumentAuthor")
  publishedDocuments                LegalDocument[]                  @relation("DocumentPublisher")
  vaultDocuments                    VaultDocument[]
  notifications                     Notification[]
  notificationPreferences           NotificationPreference?
  categoryPreferences               NotificationCategoryPreference[]
  policies                          Policy[]
  sessions                          Session[]
  organization                      Organization?                    @relation(fields: [organizationId], references: [id])
  queryFeedbacks                    QueryFeedback[]
  savedResponses                    SavedResponse[]
  corpusGapFeedbacks                CorpusGapFeedback[]
  corpusGapReports                  CorpusGapReport[]
  supportTickets                    SupportTicket[]
  ticketComments                    TicketComment[]
  regulatoryApplications            RegulatoryApplication[]
  licensesAssigned                  License[]                        @relation("LicenseAssignedOwner")
  licensesCreated                   License[]                        @relation("LicenseCreatedBy")
  licensesUpdated                   License[]                        @relation("LicenseUpdatedBy")
  licenseTimelineAssigned           LicenseTimelineEvent[]           @relation("LicenseTimelineAssignedTo")
  licenseTimelineCreated            LicenseTimelineEvent[]           @relation("LicenseTimelineCreatedBy")
  licenseTimelineUpdated            LicenseTimelineEvent[]           @relation("LicenseTimelineUpdatedBy")
  licenseDocumentsCreated           LicenseDocument[]                @relation("LicenseDocumentCreatedBy")
  licenseFeesCreated                LicenseFee[]                     @relation("LicenseFeeCreatedBy")
  licenseFeesUpdated                LicenseFee[]                     @relation("LicenseFeeUpdatedBy")
  applicationTimelineEvents         ApplicationTimelineEvent[]
  applicationDocuments              ApplicationDocument[]
  applicationFees                   ApplicationFee[]
  applicationFeedback               ApplicationRegulatorFeedback[]

  // Free trial fields (one-time, user-scoped -- not org-scoped)
  freeTrialActivatedAt DateTime?
  freeTrialExpiresAt   DateTime?
  freeTrialUsage       Json? // TrialUsage: { complianceQueries, gapAnalyses, checklists, vaultUploads, totalTokensUsed }

  // Pilot testing fields (14-day closed beta -- additive, never touched for non-pilot users)
  isPilot                       Boolean             @default(false)
  pilotCohort                   String? // e.g. "PILOT_COHORT_001"
  pilotStartedAt                DateTime?
  pilotExpiresAt                DateTime?
  pilotAccessStatus             String              @default("ACTIVE") // ACTIVE | EXPIRED | CONVERTED | REVOKED
  pilotFirstExtensionGrantedAt  DateTime?
  pilotSecondExtensionGrantedAt DateTime?
  pilotExtensionCount           Int                 @default(0)
  pilotCreatedByAdminId         String?
  pilotLastExtendedByAdminId    String?
  postPilotTier                 String              @default("REGULATOR") // tier to revert to after pilot expires
  pilotConvertedAt              DateTime? // set when pilot converts to a paid plan
  pilotEvents                   PilotEvent[]
  pilotAccesses                 PilotAccess[]
  publishedAlerts               RegulatoryAlert[]
  alertNotifications            AlertNotification[]

  // Account deletion fields (GDPR compliant scheduled deletion)
  deletionScheduledAt DateTime?
  deletionReason      String?
  deletionFeedback    String?

  // =====================================================
  // Marketing & Outreach module relations (Phase B1)
  // =====================================================
  companiesCreated            Company[]               @relation("CompanyCreatedBy")
  contactsCreated             Contact[]               @relation("ContactCreatedBy")
  contactListsCreated         ContactList[]           @relation("ContactListCreatedBy")
  contactListMembershipsAdded ContactListMembership[] @relation("ContactListMembershipAddedBy")
  marketingCampaignsCreated   MarketingCampaign[]     @relation("MarketingCampaignCreatedBy")
  suppressionsAdded           SuppressionList[]       @relation("SuppressionAddedBy")
  pilotInvitationsCreated     PilotInvitation[]       @relation("PilotInvitationCreatedBy")
  pilotApplicationsReviewed   PilotApplication[]      @relation("PilotApplicationReviewedBy")
  pilotApplicationProvisioned PilotApplication?       @relation("PilotApplicationProvisionedUser")

  // Enterprise AI Policy Generator
  generatedPolicies GeneratedPolicy[]
  aiJobs            AiJob[]

  // Organization membership (multi-member orgs)
  organizationMemberships OrganizationMember[] @relation("OrganizationMemberUser")
  sentInvitations         OrganizationMember[] @relation("OrganizationMemberInviter")

  // Blog CMS
  blogPostsAuthored                BlogPost[]               @relation("BlogPostAuthor")
  blogPostsReviewed                BlogPost[]               @relation("BlogPostReviewer")
  blogPostsUpdated                 BlogPost[]               @relation("BlogPostUpdatedBy")
  blogPostFeedbacks                BlogPostFeedback[]       @relation("BlogPostFeedbackUser")
  blogSourceMonitorsVerified       BlogSourceMonitor[]      @relation("BlogSourceMonitorVerifiedBy")
  blogSourceMonitorsCreated        BlogSourceMonitor[]      @relation("BlogSourceMonitorCreatedBy")
  blogSourceMonitorsUpdated        BlogSourceMonitor[]      @relation("BlogSourceMonitorUpdatedBy")
  blogDiscoveryRunsTriggered       BlogDiscoveryRun[]       @relation("BlogDiscoveryRunTriggeredBy")
  blogSuggestionsDismissed         BlogArticleSuggestion[]  @relation("BlogSuggestionDismissedBy")
  blogSuggestionsApproved          BlogArticleSuggestion[]  @relation("BlogSuggestionApprovedBy")
  blogDraftGenerationRunsRequested BlogDraftGenerationRun[] @relation("BlogDraftGenerationRequestedBy")
  blogDraftGenerationRunsApplied   BlogDraftGenerationRun[] @relation("BlogDraftGenerationAppliedBy")

  blogVerificationRunsRequested BlogVerificationRun[] @relation("BlogVerificationRunRequestedBy")

  // Pack 1 — Editorial Intelligence
  blogResearchPacksReviewed    BlogResearchPack[]    @relation("BlogResearchPackReviewedBy")
  contentOpsAlertsAcknowledged ContentOpsAlert[]     @relation("ContentOpsAlertAcknowledgedBy")
  contentOpsAlertsResolved     ContentOpsAlert[]     @relation("ContentOpsAlertResolvedBy")
  blogRevisionsRequested       BlogRevisionRequest[] @relation("BlogRevisionRequestedBy")
  blogRevisionsAssigned        BlogRevisionRequest[] @relation("BlogRevisionAssignedTo")
  blogRevisionsApproved        BlogRevisionRequest[] @relation("BlogRevisionApprovedBy")

  @@index([email])
  @@index([supabaseAuthId])
  @@index([organizationId])
  @@index([role])
  @@index([accountStatus])
  @@index([deletedAt])
  @@index([isPilot])
}

model Organization {
  id                      String             @id @default(cuid())
  name                    String
  type                    String
  organizationType        String             @default("startup") // "regulator" | "startup" | "enterprise"
  registrationNumber      String?
  cbkLicenseNumber        String?
  website                 String?
  industry                String?
  size                    String?
  subscriptionTier        String             @default("starter")
  subscriptionStatus      SubscriptionStatus @default(ACTIVE)
  trialEndsAt             DateTime?
  gracePeriodEndsAt       DateTime? // set on cancellation; org keeps plan until this passes
  cancelledAt             DateTime? // when the user initiated cancellation
  subscriptionEndsAt      DateTime?
  verificationStatus      String             @default("pending") // "pending" | "verified" | "rejected"
  verifiedAt              DateTime?
  verifiedBy              String?
  // Plan entitlements (new - additive)
  plan                    SubscriptionPlan   @default(REGULATOR)
  planStartDate           DateTime?
  planEndDate             DateTime?
  maxSeats                Int                @default(1)
  stripeCustomerId        String?            @unique
  stripeSubId             String?            @unique
  customLimits            Json?
  // M-Pesa / IntaSend payment fields
  preferredPaymentMethod  PaymentProvider? // STRIPE | MPESA; null = Stripe default
  mpesaPhoneNumber        String? // stored as 254XXXXXXXXX
  mpesaNextPaymentDueDate DateTime? // set on each successful M-Pesa payment; lazy-evaluated for renewal

  // ---- M-Pesa subscription lifecycle (added 2026-05-26) ----
  // Rolling 30-day cycle end. Drives renewal cron and access-revocation gate.
  // Written in parallel with mpesaNextPaymentDueDate during the transition
  // window. Both fields hold the same value on every successful payment.
  // mpesaNextPaymentDueDate is retained for backwards compatibility and will
  // be deprecated in a follow-up cleanup batch after one production cycle.
  subscriptionCycleEnd DateTime?

  // Consecutive failed renewal attempts. Resets to 0 on every successful
  // payment. When this reaches 5, the organization is downgraded to REGULATOR
  // and no further STK pushes are sent.
  mpesaFailedRenewalAttempts Int @default(0)

  // Timestamp of the most recent renewal STK push attempt (success OR failure).
  // Used by the cron to enforce the 24-hour retry cadence.
  mpesaLastRenewalAttemptAt DateTime?

  // Scheduled time of the next renewal STK push attempt. The cron polls
  // orgs where this timestamp is in the past and subscriptionStatus is
  // ACTIVE (cycle expired) or PAST_DUE.
  mpesaNextRenewalRetryAt DateTime?

  // User-initiated cancellation timestamp. Distinct from cancelledAt, which
  // also fires on auto-downgrade. Set only when an OWNER/ADMIN explicitly
  // invokes billing.cancelMpesaSubscription. Used for analytics and to
  // distinguish voluntary churn from involuntary churn.
  mpesaCancelledByUserAt DateTime?
  // Contact Information - Primary contact for regulatory matters
  address                String?
  contactPerson          String?
  contactPosition        String?
  contactEmail           String?
  contactPhone           String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  users                  User[]
  policies               Policy[]
  complianceItems        ComplianceItem[]
  complianceSnapshots    ComplianceScoreSnapshot[]
  complianceEvents       ComplianceEvent[]
  vaultDocuments         VaultDocument[]
  usageRecords           UsageRecord[]
  usagePeriods           UsagePeriod[]
  payments               Payment[]
  alertSubscription      AlertSubscription?
  alertNotifications     AlertNotification[]
  regulatoryApplications RegulatoryApplication[]
  licenses               License[]
  licenseTimelineEvents  LicenseTimelineEvent[]
  licenseDocuments       LicenseDocument[]
  licenseFees            LicenseFee[]

  // Enterprise AI Policy Generator
  generatedPolicies GeneratedPolicy[]
  checklists        Checklist[]
  aiJobs            AiJob[]

  // Organization membership (multi-member orgs)
  members OrganizationMember[] @relation("OrganizationMembers")

  pilotAccesses       PilotAccess[]
  corpusGapFeedbacks  CorpusGapFeedback[]
  corpusGapReports    CorpusGapReport[]
  customFrameworks    CustomFramework[]
  enterpriseContracts EnterpriseContract[]
  salesOutreachDrafts SalesOutreachDraft[]

  @@index([name])
  @@index([verificationStatus])
  @@index([plan])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  device       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Policy {
  id                     String        @id @default(cuid())
  userId                 String
  organizationId         String?
  scenario               String
  regulatoryAreas        String[]
  urgency                String
  stakeholders           String[]
  title                  String?
  executiveSummary       String?
  analysis               String?
  recommendations        Json?
  complianceChecklist    Json?
  implementationTimeline Json?
  appendices             Json?
  content                String?       @db.Text
  organizationType       String?
  specificRequirements   String?
  targetAudience         String?
  generationMetadata     Json?
  isLatestVersion        Boolean       @default(true)
  parentId               String?
  status                 PolicyStatus  @default(DRAFT)
  generationTime         Int?
  version                Int           @default(1)
  assignedTo             String?
  reviewers              String[]
  deletedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  citations              Citation[]
  comments               Comment[]
  user                   User          @relation(fields: [userId], references: [id])
  organization           Organization? @relation(fields: [organizationId], references: [id])
  parent                 Policy?       @relation("PolicyVersions", fields: [parentId], references: [id])
  versions               Policy[]      @relation("PolicyVersions")

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Citation {
  id String @id @default(cuid())

  // Polymorphic parent -- exactly one should be set
  policyId String?
  policy   Policy? @relation(fields: [policyId], references: [id], onDelete: Cascade)

  complianceQueryId String?
  complianceQuery   ComplianceQuery? @relation("ComplianceQueryCitations", fields: [complianceQueryId], references: [id], onDelete: Cascade)

  actName     String
  section     String
  subsection  String?
  textSnippet String  @db.Text
  confidence  String
  verified    Boolean @default(false)

  // Link to legal corpus when identifiable from RAG
  documentId String?
  document   LegalDocument? @relation(fields: [documentId], references: [id])

  // Fallback for RAG-sourced citations with no DB record
  rawSource Json?

  createdAt DateTime @default(now())

  @@index([policyId])
  @@index([complianceQueryId])
  @@index([documentId])
}

model Comment {
  id        String   @id @default(cuid())
  policyId  String
  userId    String
  content   String
  resolved  Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model LegalDocument {
  id               String          @id @default(cuid())
  actName          String
  documentType     String
  enactmentDate    DateTime?
  effectiveDate    DateTime?
  amendedBy        String[]
  regulatoryBody   String?
  originalFilename String
  fileUrl          String
  fileSize         Int
  mimeType         String
  status           DocumentStatus  @default(UPLOADING)
  totalChunks      Int?
  processedAt      DateTime?
  fullText         String?
  summary          String?
  keywords         String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  authorId         String?
  category         String?
  content          String?
  contentStatus    ContentStatus   @default(DRAFT)
  contentType      ContentType     @default(REGULATORY_DOCUMENT)
  deletedAt        DateTime?
  excerpt          String?
  helpfulCount     Int             @default(0)
  htmlContent      String?
  isLatestVersion  Boolean         @default(true)
  notHelpfulCount  Int             @default(0)
  organizationId   String?
  parentId         String?
  publishedAt      DateTime?
  publishedBy      String?
  seoDescription   String?
  seoKeywords      String[]        @default([])
  seoTitle         String?
  slug             String?         @unique
  subcategory      String?
  tags             String[]        @default([])
  title            String?
  userId           String?
  version          Int             @default(1)
  viewCount        Int             @default(0)
  citations        Citation[]
  chunks           DocumentChunk[]
  shares           DocumentShare[]
  author           User?           @relation("DocumentAuthor", fields: [authorId], references: [id])
  parent           LegalDocument?  @relation("DocumentVersions", fields: [parentId], references: [id])
  versions         LegalDocument[] @relation("DocumentVersions")
  publisher        User?           @relation("DocumentPublisher", fields: [publishedBy], references: [id])

  @@index([actName])
  @@index([status])
  @@index([contentType, contentStatus])
  @@index([slug])
  @@index([category, subcategory])
  @@index([organizationId, contentType])
  @@index([authorId])
}

model DocumentChunk {
  id            String        @id @default(cuid())
  documentId    String
  chunkIndex    Int
  sectionNumber String?
  subsection    String?
  text          String
  embedding     Float[]
  wordCount     Int
  createdAt     DateTime      @default(now())
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sectionNumber])
}

model ComplianceQuery {
  id                 String                  @id @default(cuid())
  userId             String
  organizationId     String?
  query              String
  response           String?
  citations          Json?
  regulatoryAreas    Json?
  confidence         Float?
  recommendations    Json?
  processingTimeMs   Int?
  metadata           Json?
  productCategory    String?
  summary            String?
  regulations        Json?
  requirements       Json?
  gaps               Json?
  status             String                  @default("processing")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id])
  feedbacks          QueryFeedback[]
  saves              SavedResponse[]
  citationRecords    Citation[]              @relation("ComplianceQueryCitations")
  runs               ComplianceQueryRun[]
  answerClaims       ComplianceAnswerClaim[]
  corpusGapFeedbacks CorpusGapFeedback[]

  @@index([userId])
  @@index([createdAt])
  @@index([organizationId])
  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
}

model ComplianceQueryRun {
  id                    String              @id @default(cuid())
  complianceQueryId     String
  shadow                Boolean             @default(false)
  status                String?             @default("completed")
  route                 String
  routeConfidence       Float?
  routeDowngraded       Boolean?
  routeDowngradeReason  String?
  grounded              Boolean             @default(false)
  ragSources            Int                 @default(0)
  subQuestions          Json?
  retrievalQueries      Json?
  gradeChunksInspected  Int                 @default(0)
  acceptedChunkIds      Json?
  rejectedChunkCount    Int?
  tokenBudgetExceeded   Boolean             @default(false)
  controlTokens         Json?
  inputTokens           Int?
  outputTokens          Int?
  graderFailed          Boolean             @default(false)
  routerParseFallback   Boolean             @default(false)
  verifierParseFallback Boolean             @default(false)
  verifierVerdict       String?
  unsupportedClaims     Json?
  fallbackReason        String?
  errorMessage          String?
  wallMs                Int
  createdAt             DateTime            @default(now())
  updatedAt             DateTime?           @updatedAt
  complianceQuery       ComplianceQuery     @relation(fields: [complianceQueryId], references: [id], onDelete: Cascade)
  corpusGapFeedbacks    CorpusGapFeedback[]

  @@index([complianceQueryId])
  @@index([shadow])
  @@index([route])
  @@index([verifierVerdict])
  @@index([createdAt])
  @@index([status])
}

model ComplianceAnswerClaim {
  id                String                    @id @default(cuid())
  complianceQueryId String
  claimText         String                    @db.Text
  claimType         String
  requiresCitation  Boolean                   @default(true)
  status            String
  confidence        Float?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  complianceQuery   ComplianceQuery           @relation(fields: [complianceQueryId], references: [id], onDelete: Cascade)
  citations         ComplianceClaimCitation[]

  @@index([complianceQueryId])
  @@index([status])
  @@index([claimType])
}

model ComplianceClaimCitation {
  id                        String                   @id @default(cuid())
  claimId                   String
  regulatoryDocumentChunkId String?
  documentId                String?
  documentTitle             String?
  section                   String?
  chunkRank                 Int?
  quoteStart                Int?
  quoteEnd                  Int?
  supportExcerpt            String                   @db.Text
  supportVerdict            String
  confidence                Float?
  verifierModel             String?
  rawSource                 Json?
  createdAt                 DateTime                 @default(now())
  claim                     ComplianceAnswerClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  regulatoryDocumentChunk   RegulatoryDocumentChunk? @relation(fields: [regulatoryDocumentChunkId], references: [id])

  @@index([claimId])
  @@index([regulatoryDocumentChunkId])
  @@index([documentId])
  @@index([supportVerdict])
}

model RegulatoryApplication {
  id                String                         @id @default(cuid())
  organizationId    String
  userId            String
  title             String
  regulator         String
  licenseType       String
  status            String                         @default("DRAFT")
  progress          Int                            @default(0)
  referenceNumber   String?
  nextAction        String?
  dueDate           DateTime?
  submittedAt       DateTime?
  decidedAt         DateTime?
  deletedAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelineEvents    ApplicationTimelineEvent[]
  documents         ApplicationDocument[]
  fees              ApplicationFee[]
  regulatorFeedback ApplicationRegulatorFeedback[]

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model ApplicationTimelineEvent {
  id            String                @id @default(cuid())
  applicationId String
  userId        String
  title         String
  description   String?
  eventDate     DateTime              @default(now())
  completed     Boolean               @default(false)
  createdAt     DateTime              @default(now())
  application   RegulatoryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([eventDate])
}

model ApplicationDocument {
  id              String                @id @default(cuid())
  applicationId   String
  userId          String
  name            String
  status          String                @default("REQUIRED")
  vaultDocumentId String?
  notes           String?
  uploadedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  application     RegulatoryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
}

model ApplicationFee {
  id            String                @id @default(cuid())
  applicationId String
  userId        String
  description   String
  amount        Int
  status        String                @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  application   RegulatoryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
}

model ApplicationRegulatorFeedback {
  id             String                @id @default(cuid())
  applicationId  String
  userId         String
  fromName       String?
  message        String
  actionRequired Boolean               @default(false)
  dueDate        DateTime?
  receivedAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())
  application    RegulatoryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([receivedAt])
}

model Checklist {
  id                 String          @id @default(cuid())
  userId             String
  organizationId     String
  title              String
  productType        String?
  businessStage      String?
  targetSegments     Json?
  servicesOffered    Json?
  additionalConcerns String?
  description        String?
  items              Json
  checklistData      Json?
  itemProgress       Json?
  progress           Int             @default(0)
  completedItems     Int             @default(0)
  totalItems         Int             @default(0)
  summary            Json?
  metadata           Json?
  generatedAt        DateTime?
  status             String          @default("GENERATING")
  dueDate            DateTime?
  completedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id])
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  checklistItems     ChecklistItem[]

  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@index([deletedAt])
}

model ChecklistItem {
  id                  String    @id @default(cuid())
  checklistId         String
  category            String
  itemCode            String?
  title               String
  description         String
  guidance            String?
  regulatoryReference String
  actionItems         Json // String[] stored as JSON array
  deadline            String?
  penalty             String?
  priority            String // CRITICAL | HIGH | MEDIUM | LOW
  status              String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | NOT_APPLICABLE
  notes               String?
  order               Int       @default(0)
  completedAt         DateTime?
  completedById       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  checklist           Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([checklistId, category])
  @@index([checklistId, status])
  @@index([priority])
}

model GapAnalysis {
  id                   String                 @id @default(cuid())
  userId               String
  organizationId       String?
  documentName         String
  documentUrl          String
  documentType         String
  regulatoryFrameworks Json
  analysisDepth        String                 @default("standard")
  focusAreas           Json?
  results              Json?
  overallScore         Int?
  status               String                 @default("UPLOADING")
  progress             Int                    @default(0)
  errorMessage         String?
  ragGrounded          Boolean                @default(true)
  chunksProcessed      Int                    @default(1)
  reportUrl            String?
  reportGeneratedAt    DateTime?
  completedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id])
  frameworks           GapAnalysisFramework[]

  // Enterprise AI Policy Generator
  generatedPolicies GeneratedPolicy[]

