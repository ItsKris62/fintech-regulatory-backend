// Vault upload lifecycle state. This is distinct from VaultDocumentStatus,
// which tracks business review status.
//
// Valid transitions enforced in the service layer:
//   (no row) -> UPLOADED     - happy path on confirmUpload success
//   (no row) -> FAILED       - confirmUpload verification failed
//   UPLOADED -> VERIFIED     - contentHash computation succeeded
//   UPLOADED -> FAILED       - contentHash mismatch on verify
//   ANY      -> QUARANTINED  - admin or automated flag
//   ANY      -> DELETED      - soft delete
enum VaultDocumentUploadStatus {
  PENDING
  UPLOADED
  VERIFIED
  FAILED
  QUARANTINED
  DELETED
}

