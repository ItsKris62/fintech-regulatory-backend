  IMPORTED_LEGITIMATE_INTEREST
}

// =============================================================================
// ENTERPRISE AI POLICY GENERATOR (Phase: Enterprise Policy Generator)
// =============================================================================

model GeneratedPolicy {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  // Policy metadata
  policyType       String // "DATA_PROTECTION" | "AML_CFT" | "IT_SECURITY" | "CONSUMER_PROTECTION" | "CYBERSECURITY" | "CUSTOM"
  title            String
  description      String?
  targetAudience   String?
  organizationType String?

  // Source gap (nullable - can be created standalone or from a gap)
  sourceGapAnalysisId String?
  sourceGapId         String? // specific gap item ID within the analysis JSON

  // Regulatory context
  regulatoryFrameworks String[] // e.g. ["DPA 2019", "POCAMLA"]
  jurisdiction         String   @default("Kenya")

  // AI Pipeline state
  status       GeneratedPolicyStatus @default(INITIALIZING)
  progress     Int                   @default(0)
  errorMessage String?

  // Content - stored as structured JSON
  tableOfContents  Json? // OutlineResult: { sections: [{id, title, description, estimatedWordCount, mandatoryClauses}] }
  sections         Json? // PolicySection[]: [{id, title, content (TipTap JSON), citations, status, wordCount}]
  executiveSummary String? @db.Text
  reviewNotes      String? @db.Text

  // Generation metadata
  generationMetadata Json? // { totalTokensUsed, totalCostUsd, model, stages: {...} }
  ragGrounded        Boolean @default(true)

  // Versioning
  version         Int     @default(1)
  parentId        String?
  isLatestVersion Boolean @default(true)

  // Export tracking
  lastExportedAt   DateTime?
  lastExportFormat String? // "DOCX" | "PDF"

  // Lifecycle
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  user              User                             @relation(fields: [userId], references: [id])
  organization      Organization                     @relation(fields: [organizationId], references: [id])
  sourceGapAnalysis GapAnalysis?                     @relation(fields: [sourceGapAnalysisId], references: [id])
  parent            GeneratedPolicy?                 @relation("GeneratedPolicyVersions", fields: [parentId], references: [id])
  versions          GeneratedPolicy[]                @relation("GeneratedPolicyVersions")
  citations         GeneratedPolicyCitation[]
  sourceSnapshots   GeneratedPolicySourceSnapshot[]
  exportLogs        GeneratedPolicyExportLog[]
  sectionVersions   GeneratedPolicySectionVersion[]
  generationEvents  GeneratedPolicyGenerationEvent[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([policyType])
  @@index([sourceGapAnalysisId])
  @@index([deletedAt])
  @@index([createdAt])
}

model GeneratedPolicyCitation {
  id                String   @id @default(cuid())
  generatedPolicyId String
  sectionId         String // references the section ID within the sections JSON
  actName           String
  section           String // e.g. "Section 26(1)(b)"
  subsection        String?
  textSnippet       String   @db.Text
  confidence        String // "high" | "medium" | "low"
  verified          Boolean  @default(false)
  citationVerified  Boolean? // post-hoc corpus verification result
  rawSource         Json? // RAG source metadata
  sourceSnapshotId  String?
  createdAt         DateTime @default(now())

  generatedPolicy GeneratedPolicy                @relation(fields: [generatedPolicyId], references: [id], onDelete: Cascade)
  sourceSnapshot  GeneratedPolicySourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  @@index([generatedPolicyId])
  @@index([sectionId])
  @@index([sourceSnapshotId])
}

model GeneratedPolicySourceSnapshot {
  id                String   @id @default(cuid())
  generatedPolicyId String
  sourceType        String
  title             String
  slug              String?
  documentId        String?
  sourceUrl         String?
  contentHash       String?
  excerpt           String?  @db.Text
  metadata          Json?
  capturedAt        DateTime @default(now())

  generatedPolicy GeneratedPolicy           @relation(fields: [generatedPolicyId], references: [id], onDelete: Cascade)
  citations       GeneratedPolicyCitation[]

  @@index([generatedPolicyId])
  @@index([documentId])
  @@index([contentHash])
}

model GeneratedPolicyExportLog {
  id                String   @id @default(cuid())
  generatedPolicyId String
  userId            String
  organizationId    String
  format            String
  storageKey        String?
  filename          String?
  metadata          Json?
  exportedAt        DateTime @default(now())

  generatedPolicy GeneratedPolicy @relation(fields: [generatedPolicyId], references: [id], onDelete: Cascade)

  @@index([generatedPolicyId])
  @@index([userId])
  @@index([organizationId])
  @@index([exportedAt])
}

model GeneratedPolicySectionVersion {
  id                String   @id @default(cuid())
  generatedPolicyId String
  sectionId         String
  version           Int
  previousContent   Json?
  newContent        Json?
  previousStatus    String?
  newStatus         String?
  editedByUserId    String
  createdAt         DateTime @default(now())

  generatedPolicy GeneratedPolicy @relation(fields: [generatedPolicyId], references: [id], onDelete: Cascade)

  @@index([generatedPolicyId])
  @@index([sectionId])
  @@index([editedByUserId])
  @@index([createdAt])
}

model GeneratedPolicyGenerationEvent {
  id                String   @id @default(cuid())
  generatedPolicyId String
  jobId             String?
  stage             String
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  costUsd           Float?
  metadata          Json?
  createdAt         DateTime @default(now())

  generatedPolicy GeneratedPolicy @relation(fields: [generatedPolicyId], references: [id], onDelete: Cascade)

  @@index([generatedPolicyId])
  @@index([jobId])
  @@index([stage])
  @@index([createdAt])
}

enum GeneratedPolicyStatus {
  INITIALIZING // Record created, pipeline not started
  OUTLINING // Stage 1: Generating table of contents
  DRAFTING // Stage 2: Writing sections (progress 10-80%)
  REVIEWING // Stage 3: Final consistency/citation review
  COMPLETED // All stages done - ready for user editing
  FAILED // Pipeline error
  ARCHIVED // User archived
}

