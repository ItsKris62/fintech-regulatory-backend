  evidenceDocument VaultDocument?   @relation("LicenseTimelineEvidenceDocument", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  complianceEvent  ComplianceEvent? @relation(fields: [complianceEventId], references: [id], onDelete: SetNull)
  createdBy        User             @relation("LicenseTimelineCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
