  licenseId       String
  organizationId  String
  vaultDocumentId String
  documentType    String?
  notes           String?  @db.Text
  createdByUserId String
  createdAt       DateTime @default(now())

  license       License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vaultDocument VaultDocument @relation("LicenseDocumentVaultDocument", fields: [vaultDocumentId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("LicenseDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([licenseId, vaultDocumentId])
  @@index([licenseId])
  @@index([organizationId])
  @@index([vaultDocumentId])
}

model LicenseFee {
  id              String    @id @default(cuid())
  licenseId       String
  organizationId  String
  amount          Decimal?  @db.Decimal(12, 2)
  currency        String    @default("KES")
  description     String?
  dueDate         DateTime?
  paidAt          DateTime?
  status          String    @default("PENDING")
  createdByUserId String
  updatedByUserId String?
