  runbookUrl String?
  metadata   Json?

  occurrences AutomationIncidentOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([environment, fingerprint])
  @@index([status, severity])
  @@index([workflowKey, lastSeenAt])
}

model AutomationIncidentOccurrence {
  id         String             @id @default(cuid())
  incidentId String
  incident   AutomationIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  idempotencyKey String? @unique

  executionId   String?
  workflowId    String?
  nodeName      String?
  nodeType      String?
  httpStatus    Int?
  errorCode     String?
  attempt       Int      @default(1)
  maxAttempts   Int?
  correlationId String?
  sentryTraceId String?
  sentryEventId String?
  safeMessage   String
  metadata      Json?
  occurredAt    DateTime

  createdAt DateTime @default(now())

  @@index([incidentId, occurredAt])
  @@index([executionId])
  @@index([correlationId])
}

// =============================================================================
// SheriaBot Pack 1 — Editorial Intelligence
// Governing spec: docs/editorial-intelligence/phase-b-*.md (Phase B.1 approved).
// Additive only — see prisma/migrations/<TS>_* for the corresponding raw SQL.
// =============================================================================

enum ContentOpsAlertNotificationStatus {
  NOT_REQUIRED
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

// Persisted content-ops alerting (Foundation C). Reuses AutomationIncidentSeverity
// and AutomationIncidentStatus verbatim rather than minting near-duplicate enums —
// see phase-b-foundations.md Foundation C. The dedupe uniqueness constraint on
// (type, entityType, entityId, COALESCE(workflowKey, '')) is a raw SQL expression
// index that Prisma's schema DSL cannot express — it is NOT declared here as a
// @@unique; it exists only in the migration SQL. createOrIncrementAlert must
// upsert via a raw query targeting that index, not Prisma Client's typed .upsert().
//
// status (AutomationIncidentStatus.IGNORED) = human content-review decision.
// notificationStatus (SUPPRESSED) = delivery-mechanics decision (cooldown). These
// are independent axes — never conflate them.
model ContentOpsAlert {
  id       String                     @id @default(cuid())
  type     String
  severity AutomationIncidentSeverity
  status   AutomationIncidentStatus   @default(OPEN)

  title   String
  summary String @db.Text // short operator-facing summary only — never article bodies, prompts, credentials, or recipient lists

  workflowKey String?
  executionId String?

  entityType String
  entityId   String

  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  notificationStatus   ContentOpsAlertNotificationStatus @default(NOT_REQUIRED)
  notificationAttempts Int                               @default(0)
  lastNotificationAt   DateTime?

  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionNote   String?   @db.Text

  metadata Json? // small structured pointers only (ids, counts, scores) — never article bodies, prompts, or credentials

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acknowledgedBy User? @relation("ContentOpsAlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  resolvedBy     User? @relation("ContentOpsAlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, severity])
  @@index([entityType, entityId])
  @@index([workflowKey, lastSeenAt])
  @@index([createdAt])
}

enum BlogEditorialRecommendation {
  PRIORITISE_NOW
  QUEUE
  MONITOR
  REJECT
  HUMAN_REVIEW_REQUIRED
}

enum BlogEditorialTriageStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

// Versioned editorial triage assessment (Domain Contract §1). New related model,
// not fields on BlogArticleSuggestion — see phase-b-data-model.md §1 for the
// reuse-vs-new-model rationale. Two unique indexes (sourceItemId, suggestionId)
// exist because Postgres ignores NULL in unique indexes; the SERVICE decides
// which single one is authoritative for a given run (sourceItemId when present,
// else suggestionId) — never both independently.
model BlogEditorialTriageRun {
  id String @id @default(cuid())

  sourceItemId String?
  suggestionId String?
  agentRunId   String?

  version Int @default(1)

  deterministicScore Int
  aiRelevanceScore   Int?
  finalScore         Int

  recommendation         BlogEditorialRecommendation
  urgency                BlogSuggestionPriority
  targetAudiences        String[]                    @default([])
  recommendedArticleType BlogArticleType?
  recommendedChannels    String[]                    @default([])
  rationale              String                      @db.Text
  sourceConfidence       Int

  requiresHumanReview Boolean @default(true)

  modelProvider String?
  modelName     String?
  promptVersion String  @default("editorial-triage-v1")
  inputHash     String

  status       BlogEditorialTriageStatus @default(PENDING)
  errorMessage String?                   @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  sourceItem BlogSourceItem?        @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  suggestion BlogArticleSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  agentRun   AgentRun?              @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([sourceItemId, version])
  @@unique([suggestionId, version])
  @@index([suggestionId])
  @@index([recommendation])
  @@index([status])
  @@index([createdAt])
}

