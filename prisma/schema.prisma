  assignedOwner User?        @relation("LicenseAssignedOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  createdBy     User         @relation("LicenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy     User?        @relation("LicenseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

