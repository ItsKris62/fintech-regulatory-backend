  // Structured {pass, provider, model, promptVersion} — never free text in `recommendation`.
  reviewProvenance        Json?

  createdAt DateTime @default(now())

  run BlogVerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([severity])
  @@index([issueType])
  @@index([claimHash])
}

