// Proactive freshness review (Domain Contract §4). blogPostId is required
// (unlike BlogResearchPack) — a freshness review only ever exists to assess an
// already-published post. onDelete: Restrict (corrected from Cascade) protects
// this audit trail; compatible with the existing soft-delete-only adminDelete
// path (see phase-b-data-model.md §4 "Deletion behavior").
model BlogFreshnessReview {
  id String @id @default(cuid())

  blogPostId String
  agentRunId String?

  triggeredBy String @default("SCHEDULE") // SCHEDULE | SIGNAL | MANUAL

  contentHash   String
  sourceSetHash String

  riskTier       BlogFreshnessRiskTier
  freshnessScore Int
  action         BlogFreshnessAction

  rationale         String   @db.Text
  changedSourceIds  String[] @default([])
  newSignalIds      String[] @default([])
  brokenSourceCount Int      @default(0)
  staleSourceCount  Int      @default(0)

  nextReviewAt DateTime?

  modelProvider String?
  modelName     String?
  promptVersion String  @default("freshness-review-v1")

  status       BlogEditorialTriageStatus @default(PENDING)
  errorMessage String?                   @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  blogPost         BlogPost              @relation(fields: [blogPostId], references: [id], onDelete: Restrict)
  agentRun         AgentRun?             @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  revisionRequests BlogRevisionRequest[]

  @@index([blogPostId, createdAt])
  @@index([action])
  @@index([nextReviewAt])
  @@index([status])
}

enum BlogRevisionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BlogRevisionStatus {
  PENDING_REVIEW
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

// Durable revision request (Domain Contract §5). idempotencyKey is required and
// always caller-supplied (corrected — never a server-synthesized 'manual'
// fallback, which would have collapsed every manual revision request for a post
// into one shared bucket). onDelete: Restrict for the same audit-retention
// reason as BlogFreshnessReview above.
model BlogRevisionRequest {
  id String @id @default(cuid())

  blogPostId        String
  freshnessReviewId String?
  idempotencyKey    String  @unique

  reason             String               @db.Text
  priority           BlogRevisionPriority
  recommendedChanges Json?
  evidence           Json?

  status BlogRevisionStatus @default(PENDING_REVIEW)

  requestedById String?
  assignedToId  String?
  approvedById  String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  blogPost        BlogPost             @relation(fields: [blogPostId], references: [id], onDelete: Restrict)
  freshnessReview BlogFreshnessReview? @relation(fields: [freshnessReviewId], references: [id], onDelete: SetNull)
  requestedBy     User?                @relation("BlogRevisionRequestedBy", fields: [requestedById], references: [id])
  assignedTo      User?                @relation("BlogRevisionAssignedTo", fields: [assignedToId], references: [id])
  approvedBy      User?                @relation("BlogRevisionApprovedBy", fields: [approvedById], references: [id])

  @@index([blogPostId, status])
  @@index([freshnessReviewId])
  @@index([status, priority])
  @@index([createdAt])
}
