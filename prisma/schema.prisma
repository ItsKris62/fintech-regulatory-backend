generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}

model User {
  id                       String                   @id @default(cuid())
  supabaseAuthId           String?                  @unique
  email                    String                   @unique
  password                 String?   // nullable — Supabase is the authoritative credential store
  fullName                 String
  phone                    String?
  avatar                   String?
  role                     UserRole
  status                   UserStatus               @default(PENDING_VERIFICATION)
  accountStatus            String                   @default("pending") // "pending" | "active" | "suspended" | "rejected" | "pending_approval"
  emailVerified            Boolean                  @default(false)
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?                  @unique
  emailVerificationExpiry  DateTime?
  passwordResetToken       String?                  @unique
  passwordResetExpiry      DateTime?
  organizationId           String?
  lastLoginAt              DateTime?
  lastLoginIp              String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?                // Soft delete timestamp — null means active
  preferences              Json?
  totpEnabled              Boolean                  @default(false)
  totpSecret               String?
  apiKeys                  ApiKey[]
  auditLogs                AuditLog[]
  checklists               Checklist[]
  gapAnalyses              GapAnalysis[]
  complianceQueries        ComplianceQuery[]
  authoredDocuments        LegalDocument[]          @relation("DocumentAuthor")
  publishedDocuments       LegalDocument[]          @relation("DocumentPublisher")
  vaultDocuments           VaultDocument[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference?
  categoryPreferences      NotificationCategoryPreference[]
  policies                 Policy[]
  sessions                 Session[]
  organization             Organization?            @relation(fields: [organizationId], references: [id])
  queryFeedbacks           QueryFeedback[]
  savedResponses           SavedResponse[]
  supportTickets           SupportTicket[]
  ticketComments           TicketComment[]

  // Free trial fields (one-time, user-scoped -- not org-scoped)
  freeTrialActivatedAt     DateTime?
  freeTrialExpiresAt       DateTime?
  freeTrialUsage           Json?       // TrialUsage: { complianceQueries, gapAnalyses, checklists, vaultUploads, totalTokensUsed }

  // Pilot testing fields (14-day closed beta -- additive, never touched for non-pilot users)
  isPilot                  Boolean   @default(false)
  pilotCohort              String?                 // e.g. "PILOT_COHORT_001"
  pilotStartedAt           DateTime?
  pilotExpiresAt           DateTime?
  postPilotTier            String    @default("REGULATOR") // tier to revert to after pilot expires
  pilotConvertedAt         DateTime?               // set when pilot converts to a paid plan
  pilotEvents              PilotEvent[]
  publishedAlerts          RegulatoryAlert[]
  alertNotifications       AlertNotification[]

  // Account deletion fields (GDPR compliant scheduled deletion)
  deletionScheduledAt      DateTime?
  deletionReason           String?
  deletionFeedback         String?

  // =====================================================
  // Marketing & Outreach module relations (Phase B1)
  // =====================================================
  companiesCreated              Company[]                @relation("CompanyCreatedBy")
  contactsCreated               Contact[]                @relation("ContactCreatedBy")
  contactListsCreated           ContactList[]            @relation("ContactListCreatedBy")
  contactListMembershipsAdded   ContactListMembership[]  @relation("ContactListMembershipAddedBy")
  marketingCampaignsCreated     MarketingCampaign[]      @relation("MarketingCampaignCreatedBy")
  suppressionsAdded             SuppressionList[]        @relation("SuppressionAddedBy")
  pilotInvitationsCreated       PilotInvitation[]        @relation("PilotInvitationCreatedBy")
  pilotApplicationsReviewed     PilotApplication[]       @relation("PilotApplicationReviewedBy")
  pilotApplicationProvisioned   PilotApplication?        @relation("PilotApplicationProvisionedUser")

  @@index([email])
  @@index([supabaseAuthId])
  @@index([organizationId])
  @@index([role])
  @@index([accountStatus])
  @@index([deletedAt])
  @@index([isPilot])
}

model Organization {
  id                 String           @id @default(cuid())
  name               String
  type               String
  organizationType   String           @default("startup") // "regulator" | "startup" | "enterprise"
  registrationNumber String?
  cbkLicenseNumber   String?
  website            String?
  industry           String?
  size               String?
  subscriptionTier   String           @default("starter")
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  trialEndsAt        DateTime?
  gracePeriodEndsAt  DateTime?          // set on cancellation; org keeps plan until this passes
  cancelledAt        DateTime?          // when the user initiated cancellation
  subscriptionEndsAt DateTime?
  verificationStatus String           @default("pending") // "pending" | "verified" | "rejected"
  verifiedAt         DateTime?
  verifiedBy         String?
  // Plan entitlements (new — additive)
  plan               SubscriptionPlan @default(REGULATOR)
  planStartDate      DateTime?
  planEndDate        DateTime?
  maxSeats           Int              @default(1)
  stripeCustomerId   String?          @unique
  stripeSubId        String?          @unique
  customLimits       Json?
  // M-Pesa / IntaSend payment fields
  preferredPaymentMethod  PaymentProvider? // STRIPE | MPESA; null = Stripe default
  mpesaPhoneNumber        String?          // stored as 254XXXXXXXXX
  mpesaNextPaymentDueDate DateTime?        // set on each successful M-Pesa payment; lazy-evaluated for renewal
  // Contact Information — Primary contact for regulatory matters
  address            String?
  contactPerson      String?
  contactPosition    String?
  contactEmail       String?
  contactPhone       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  users                   User[]
  policies                Policy[]
  complianceItems         ComplianceItem[]
  complianceSnapshots     ComplianceScoreSnapshot[]
  complianceEvents        ComplianceEvent[]
  vaultDocuments          VaultDocument[]
  usageRecords            UsageRecord[]
  usagePeriods            UsagePeriod[]
  payments                Payment[]
  alertSubscription       AlertSubscription?
  alertNotifications      AlertNotification[]

  @@index([name])
  @@index([verificationStatus])
  @@index([plan])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  device       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Policy {
  id                     String       @id @default(cuid())
  userId                 String
  organizationId         String?
  scenario               String
  regulatoryAreas        String[]
  urgency                String
  stakeholders           String[]
  title                  String?
  executiveSummary       String?
  analysis               String?
  recommendations        Json?
  complianceChecklist    Json?
  implementationTimeline Json?
  appendices             Json?
  content                String?      @db.Text
  organizationType       String?
  specificRequirements   String?
  targetAudience         String?
  generationMetadata     Json?
  isLatestVersion        Boolean      @default(true)
  parentId               String?
  status                 PolicyStatus @default(DRAFT)
  generationTime         Int?
  version                Int          @default(1)
  assignedTo             String?
  reviewers              String[]
  deletedAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  citations              Citation[]
  comments               Comment[]
  user                   User         @relation(fields: [userId], references: [id])
  organization           Organization? @relation(fields: [organizationId], references: [id])
  parent                 Policy?      @relation("PolicyVersions", fields: [parentId], references: [id])
  versions               Policy[]     @relation("PolicyVersions")

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Citation {
  id                String          @id @default(cuid())

  // Polymorphic parent -- exactly one should be set
  policyId          String?
  policy            Policy?         @relation(fields: [policyId], references: [id], onDelete: Cascade)

  complianceQueryId String?
  complianceQuery   ComplianceQuery? @relation("ComplianceQueryCitations", fields: [complianceQueryId], references: [id], onDelete: Cascade)

  actName           String
  section           String
  subsection        String?
  textSnippet       String          @db.Text
  confidence        String
  verified          Boolean         @default(false)

  // Link to legal corpus when identifiable from RAG
  documentId        String?
  document          LegalDocument?  @relation(fields: [documentId], references: [id])

  // Fallback for RAG-sourced citations with no DB record
  rawSource         Json?

  createdAt         DateTime        @default(now())

  @@index([policyId])
  @@index([complianceQueryId])
  @@index([documentId])
}

model Comment {
  id        String   @id @default(cuid())
  policyId  String
  userId    String
  content   String
  resolved  Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model LegalDocument {
  id               String          @id @default(cuid())
  actName          String
  documentType     String
  enactmentDate    DateTime?
  effectiveDate    DateTime?
  amendedBy        String[]
  regulatoryBody   String?
  originalFilename String
  fileUrl          String
  fileSize         Int
  mimeType         String
  status           DocumentStatus  @default(UPLOADING)
  totalChunks      Int?
  processedAt      DateTime?
  fullText         String?
  summary          String?
  keywords         String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  authorId         String?
  category         String?
  content          String?
  contentStatus    ContentStatus   @default(DRAFT)
  contentType      ContentType     @default(REGULATORY_DOCUMENT)
  deletedAt        DateTime?
  excerpt          String?
  helpfulCount     Int             @default(0)
  htmlContent      String?
  isLatestVersion  Boolean         @default(true)
  notHelpfulCount  Int             @default(0)
  organizationId   String?
  parentId         String?
  publishedAt      DateTime?
  publishedBy      String?
  seoDescription   String?
  seoKeywords      String[]        @default([])
  seoTitle         String?
  slug             String?         @unique
  subcategory      String?
  tags             String[]        @default([])
  title            String?
  userId           String?
  version          Int             @default(1)
  viewCount        Int             @default(0)
  citations        Citation[]
  chunks           DocumentChunk[]
  shares           DocumentShare[]
  author           User?           @relation("DocumentAuthor", fields: [authorId], references: [id])
  parent           LegalDocument?  @relation("DocumentVersions", fields: [parentId], references: [id])
  versions         LegalDocument[] @relation("DocumentVersions")
  publisher        User?           @relation("DocumentPublisher", fields: [publishedBy], references: [id])

  @@index([actName])
  @@index([status])
  @@index([contentType, contentStatus])
  @@index([slug])
  @@index([category, subcategory])
  @@index([organizationId, contentType])
  @@index([authorId])
}

model DocumentChunk {
  id            String        @id @default(cuid())
  documentId    String
  chunkIndex    Int
  sectionNumber String?
  subsection    String?
  text          String
  embedding     Float[]
  wordCount     Int
  createdAt     DateTime      @default(now())
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sectionNumber])
}

model ComplianceQuery {
  id               String   @id @default(cuid())
  userId           String
  organizationId   String?
  query            String
  response         String?
  citations        Json?
  regulatoryAreas  Json?
  confidence       Float?
  recommendations  Json?
  processingTimeMs Int?
  metadata         Json?
  productCategory  String?
  summary          String?
  regulations      Json?
  requirements     Json?
  gaps             Json?
  status           String   @default("processing")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  feedbacks        QueryFeedback[]
  saves            SavedResponse[]
  citationRecords  Citation[]  @relation("ComplianceQueryCitations")

  @@index([userId])
  @@index([createdAt])
  @@index([organizationId])
  @@index([status])
}

model Checklist {
  id                 String          @id @default(cuid())
  userId             String
  organizationId     String?
  title              String
  productType        String?
  businessStage      String?
  targetSegments     Json?
  servicesOffered    Json?
  additionalConcerns String?
  description        String?
  items              Json
  checklistData      Json?
  itemProgress       Json?
  progress           Int             @default(0)
  completedItems     Int             @default(0)
  totalItems         Int             @default(0)
  summary            Json?
  metadata           Json?
  generatedAt        DateTime?
  status             String          @default("GENERATING")
  dueDate            DateTime?
  completedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id])
  checklistItems     ChecklistItem[]

  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@index([deletedAt])
}

model ChecklistItem {
  id                  String    @id @default(cuid())
  checklistId         String
  category            String
  itemCode            String?
  title               String
  description         String
  guidance            String?
  regulatoryReference String
  actionItems         Json      // String[] stored as JSON array
  deadline            String?
  penalty             String?
  priority            String    // CRITICAL | HIGH | MEDIUM | LOW
  status              String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | NOT_APPLICABLE
  notes               String?
  order               Int       @default(0)
  completedAt         DateTime?
  completedById       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  checklist           Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([checklistId, category])
  @@index([checklistId, status])
  @@index([priority])
}

model GapAnalysis {
  id                   String    @id @default(cuid())
  userId               String
  organizationId       String?
  documentName         String
  documentUrl          String
  documentType         String
  regulatoryFrameworks Json
  analysisDepth        String    @default("standard")
  focusAreas           Json?
  results              Json?
  overallScore         Int?
  status               String    @default("UPLOADING")
  progress             Int       @default(0)
  errorMessage         String?
  ragGrounded          Boolean   @default(true)
  chunksProcessed      Int       @default(1)
  reportUrl            String?
  reportGeneratedAt    DateTime?
  completedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  category  NotificationCategory @default(SYSTEM)
  title     String
  message   String
  link      String?
  read      Boolean              @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime             @default(now())
  eventId   String?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     ComplianceEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read, createdAt])
  @@index([userId, category, createdAt])
  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  key        String    @unique
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model UsageMetric {
  id                String   @id @default(cuid())
  date              DateTime
  organizationId    String?
  userId            String?
  policiesGenerated Int      @default(0)
  queriesProcessed  Int      @default(0)
  avgGenerationTime Float?
  citationAccuracy  Float?

  @@unique([date, organizationId, userId])
  @@index([date])
  @@index([organizationId])
}

model DocumentShare {
  id           String        @id @default(cuid())
  documentId   String
  token        String        @unique
  sharedBy     String
  expiresAt    DateTime?
  maxDownloads Int?
  downloads    Int           @default(0)
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  document     LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([token])
  @@index([sharedBy])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  userId     String?
  orgId      String?
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([orgId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  category    String   @default("feature") // "system" | "billing" | "feature" | "experiment"
  metadata    Json?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([name])
  @@index([category])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string") // "string" | "number" | "boolean" | "json"
  category    String   @default("general") // "general" | "security" | "ai" | "storage" | "email" | "billing"
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([category])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  success       Boolean
  ipAddress     String?
  userAgent     String?
  failureReason String?
  location      String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@index([success])
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  role           String    // Target role: REGULATOR, STARTUP, ENTERPRISE
  token          String    @unique
  expiresAt      DateTime
  used           Boolean   @default(false)
  usedAt         DateTime?
  invitedBy      String    // Admin user ID
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([token])
}

model EmailDomainWhitelist {
  id        String   @id @default(cuid())
  domain    String   @unique
  orgType   String   // "regulator"
  orgName   String   // "Central Bank of Kenya"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id                        String  @id @default(cuid())
  userId                    String  @unique
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // General Email Notifications
  regulatoryUpdates         Boolean @default(true)
  deadlineReminders         Boolean @default(true)
  reportReady               Boolean @default(true)
  supportResponses          Boolean @default(true)

  // In-App Notifications
  realTimeAlerts            Boolean @default(true)

  // Email Digest
  emailDigestEnabled        Boolean @default(false)
  digestFrequency           String  @default("weekly") // "daily" | "weekly" | "monthly"

  // Billing notifications (toggleable)
  paymentDueReminder        Boolean @default(true)

  // Compliance/system notifications (toggleable)
  complianceQueryReady      Boolean @default(true)
  policyDocumentReady       Boolean @default(true)
  documentIngestionComplete Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  REGULATOR
  STARTUP
  ENTERPRISE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PolicyStatus {
  DRAFT
  PROCESSING
  GENERATING
  COMPLETED
  FAILED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  INDEXED
  FAILED
}

enum ContentType {
  REGULATORY_DOCUMENT
  BLOG_POST
  KNOWLEDGE_BASE_ARTICLE
  POLICY_TEMPLATE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNDER_REVIEW
}

enum NotificationType {
  // ── Existing (all callers preserved) ──────────────────────────────────────
  POLICY_READY
  COMMENT_ADDED
  REVIEW_REQUESTED
  COMPLIANCE_ALERT
  SYSTEM_UPDATE
  TICKET_CREATED
  TICKET_STATUS_UPDATE
  TICKET_RESPONSE

  // ── Security events ────────────────────────────────────────────────────────
  PASSWORD_CHANGED
  PASSWORD_CHANGE_FAILED
  LOGIN_NEW_DEVICE

  // ── Compliance events ──────────────────────────────────────────────────────
  CHECKLIST_GENERATED
  CHECKLIST_COMPLETED
  GAP_ANALYSIS_STARTED
  GAP_ANALYSIS_COMPLETED

  // ── Document vault ────────────────────────────────────────────────────────
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED

  // ── Account events ────────────────────────────────────────────────────────
  PROFILE_UPDATED
  ORGANIZATION_UPDATED
  SUBSCRIPTION_CHANGED
  SUBSCRIPTION_EXPIRING

  // ── Support tickets ───────────────────────────────────────────────────────
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_UPDATED

  // ── System ────────────────────────────────────────────────────────────────
  SYSTEM_ANNOUNCEMENT

  // ── Calendar events ───────────────────────────────────────────────────────
  EVENT_CREATED
  EVENT_REMINDER
}

enum NotificationCategory {
  SECURITY    // Password changes, login alerts, and security events
  COMPLIANCE  // Checklists, gap analysis, policy docs
  DOCUMENTS   // Vault uploads, deletions, and vault activity
  ACCOUNT     // Profile changes, organization updates, and subscription events
  SUPPORT     // Support ticket creation and status updates
  SYSTEM      // Platform announcements and maintenance notices
}

model NotificationCategoryPreference {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  inAppEnabled Boolean              @default(true)
  emailEnabled Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

// ============================================================================
// Support Ticket System
// ============================================================================

enum TicketCategory {
  BILLING
  TECHNICAL
  COMPLIANCE_QUERY
  ACCOUNT
  FEATURE_REQUEST
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  description  String          @db.Text
  category     TicketCategory
  priority     TicketPriority  @default(MEDIUM)
  status       TicketStatus    @default(OPEN)
  comments     TicketComment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  closedAt     DateTime?

  @@index([userId])
  @@index([status])
  @@index([ticketNumber])
  @@index([createdAt])
}

model TicketComment {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String        @db.Text
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@index([ticketId, createdAt])
}

model RegulatoryDocument {
  id              String                     @id @default(cuid())
  title           String
  fileName        String
  fileType        String
  source          String
  category        RegulatoryDocumentCategory
  jurisdiction    String
  documentType    String
  effectiveDate   DateTime?
  version         String?
  storageKey      String
  status          RegulatoryDocumentStatus   @default(PENDING)
  checksum        String?
  chunkCount      Int?
  totalCharacters Int?
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  chunks          RegulatoryDocumentChunk[]

  @@index([status])
  @@index([category])
  @@index([jurisdiction])
  @@index([checksum])
}

model RegulatoryDocumentChunk {
  id         String             @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  section    String?
  tokenCount Int
  pineconeId String             @unique
  createdAt  DateTime           @default(now())
