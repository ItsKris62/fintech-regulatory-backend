model CorpusGapFeedback {
  id                String    @id @default(cuid())
  complianceQueryId String
  runId             String
  // onDelete: Restrict -- user deletion is blocked if gap feedback rows exist.
  // ODPC traceability requirement: compliance gap evidence must not be silently
  // destroyed on user deletion. Deactivate the user account instead.
  userId            String
  organizationId    String
