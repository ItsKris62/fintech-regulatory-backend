generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}

model User {
  id                       String                   @id @default(cuid())
  supabaseAuthId           String?                  @unique
  email                    String                   @unique
  password                 String
  fullName                 String
  phone                    String?
  avatar                   String?
  role                     UserRole
  status                   UserStatus               @default(PENDING_VERIFICATION)
  accountStatus            String                   @default("pending") // "pending" | "active" | "suspended" | "rejected" | "pending_approval"
  emailVerified            Boolean                  @default(false)
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?                  @unique
  emailVerificationExpiry  DateTime?
  passwordResetToken       String?                  @unique
  passwordResetExpiry      DateTime?
  organizationId           String?
  lastLoginAt              DateTime?
  lastLoginIp              String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  preferences              Json?
  totpEnabled              Boolean                  @default(false)
  totpSecret               String?
  apiKeys                  ApiKey[]
  auditLogs                AuditLog[]
  checklists               Checklist[]
  gapAnalyses              GapAnalysis[]
  complianceQueries        ComplianceQuery[]
  authoredDocuments        LegalDocument[]          @relation("DocumentAuthor")
  publishedDocuments       LegalDocument[]          @relation("DocumentPublisher")
  vaultDocuments           VaultDocument[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference?
  policies                 Policy[]
  sessions                 Session[]
  organization             Organization?            @relation(fields: [organizationId], references: [id])
  queryFeedbacks           QueryFeedback[]
  savedResponses           SavedResponse[]

  @@index([email])
  @@index([supabaseAuthId])
  @@index([organizationId])
  @@index([role])
  @@index([accountStatus])
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  type               String
  organizationType   String    @default("startup") // "regulator" | "startup" | "enterprise"
  registrationNumber String?
  cbkLicenseNumber   String?
  website            String?
  industry           String?
  size               String?
  subscriptionTier   String    @default("starter")
  subscriptionStatus String    @default("trial")
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  verificationStatus String    @default("pending") // "pending" | "verified" | "rejected"
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  users                   User[]
  complianceItems         ComplianceItem[]
  complianceSnapshots     ComplianceScoreSnapshot[]
  vaultDocuments          VaultDocument[]

  @@index([name])
  @@index([verificationStatus])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  device       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Policy {
  id                     String       @id @default(cuid())
  userId                 String
  scenario               String
  regulatoryAreas        String[]
  urgency                String
  stakeholders           String[]
  title                  String?
  executiveSummary       String?
  analysis               String?
  recommendations        Json?
  complianceChecklist    Json?
  implementationTimeline Json?
  appendices             Json?
  status                 PolicyStatus @default(DRAFT)
  generationTime         Int?
  version                Int          @default(1)
  assignedTo             String?
  reviewers              String[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  citations              Citation[]
  comments               Comment[]
  user                   User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Citation {
  id          String         @id @default(cuid())
  policyId    String
  actName     String
  section     String
  subsection  String?
  textSnippet String
  confidence  String
  verified    Boolean        @default(false)
  documentId  String?
  createdAt   DateTime       @default(now())
  document    LegalDocument? @relation(fields: [documentId], references: [id])
  policy      Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([documentId])
}

model Comment {
  id        String   @id @default(cuid())
  policyId  String
  userId    String
  content   String
  resolved  Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model LegalDocument {
  id               String          @id @default(cuid())
  actName          String
  documentType     String
  enactmentDate    DateTime?
  effectiveDate    DateTime?
  amendedBy        String[]
  regulatoryBody   String?
  originalFilename String
  fileUrl          String
  fileSize         Int
  mimeType         String
  status           DocumentStatus  @default(UPLOADING)
  totalChunks      Int?
  processedAt      DateTime?
  fullText         String?
  summary          String?
  keywords         String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  authorId         String?
  category         String?
  content          String?
  contentStatus    ContentStatus   @default(DRAFT)
  contentType      ContentType     @default(REGULATORY_DOCUMENT)
  deletedAt        DateTime?
  excerpt          String?
  helpfulCount     Int             @default(0)
  htmlContent      String?
  isLatestVersion  Boolean         @default(true)
  notHelpfulCount  Int             @default(0)
  organizationId   String?
  parentId         String?
  publishedAt      DateTime?
  publishedBy      String?
  seoDescription   String?
  seoKeywords      String[]        @default([])
  seoTitle         String?
  slug             String?         @unique
  subcategory      String?
  tags             String[]        @default([])
  title            String?
  userId           String?
  version          Int             @default(1)
  viewCount        Int             @default(0)
  citations        Citation[]
  chunks           DocumentChunk[]
  shares           DocumentShare[]
  author           User?           @relation("DocumentAuthor", fields: [authorId], references: [id])
  parent           LegalDocument?  @relation("DocumentVersions", fields: [parentId], references: [id])
  versions         LegalDocument[] @relation("DocumentVersions")
  publisher        User?           @relation("DocumentPublisher", fields: [publishedBy], references: [id])

  @@index([actName])
  @@index([status])
  @@index([contentType, contentStatus])
  @@index([slug])
  @@index([category, subcategory])
  @@index([organizationId, contentType])
  @@index([authorId])
}

model DocumentChunk {
  id            String        @id @default(cuid())
  documentId    String
  chunkIndex    Int
  sectionNumber String?
  subsection    String?
  text          String
  embedding     Float[]
  wordCount     Int
  createdAt     DateTime      @default(now())
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sectionNumber])
}

model ComplianceQuery {
  id               String   @id @default(cuid())
  userId           String
  organizationId   String?
  query            String
  response         String?
  citations        Json?
  regulatoryAreas  Json?
  confidence       Float?
  recommendations  Json?
  processingTimeMs Int?
  metadata         Json?
  productCategory  String?
  summary          String?
  regulations      Json?
  requirements     Json?
  gaps             Json?
  status           String   @default("processing")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  feedbacks        QueryFeedback[]
  saves            SavedResponse[]

  @@index([userId])
  @@index([createdAt])
  @@index([organizationId])
  @@index([status])
}

model Checklist {
  id                 String    @id @default(cuid())
  userId             String
  organizationId     String?
  title              String
  productType        String?
  businessStage      String?
  targetSegments     Json?
  servicesOffered    Json?
  additionalConcerns String?
  description        String?
  items              Json
  checklistData      Json?
  itemProgress       Json?
  progress           Int       @default(0)
  status             String    @default("GENERATING")
  dueDate            DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([organizationId])
}

model GapAnalysis {
  id                   String   @id @default(cuid())
  userId               String
  organizationId       String?
  documentName         String
  documentUrl          String
  documentType         String
  regulatoryFrameworks Json
  analysisDepth        String   @default("standard")
  focusAreas           Json?
  results              Json?
  overallScore         Int?
  status               String   @default("UPLOADING")
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  key        String    @unique
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model UsageMetric {
  id                String   @id @default(cuid())
  date              DateTime
  organizationId    String?
  userId            String?
  policiesGenerated Int      @default(0)
  queriesProcessed  Int      @default(0)
  avgGenerationTime Float?
  citationAccuracy  Float?

  @@unique([date, organizationId, userId])
  @@index([date])
  @@index([organizationId])
}

model DocumentShare {
  id           String        @id @default(cuid())
  documentId   String
  token        String        @unique
  sharedBy     String
  expiresAt    DateTime?
  maxDownloads Int?
  downloads    Int           @default(0)
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  document     LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([token])
  @@index([sharedBy])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  userId     String?
  orgId      String?
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([orgId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([name])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  role           String    // Target role: REGULATOR, STARTUP, ENTERPRISE
  token          String    @unique
  expiresAt      DateTime
  used           Boolean   @default(false)
  usedAt         DateTime?
  invitedBy      String    // Admin user ID
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([token])
}

model EmailDomainWhitelist {
  id        String   @id @default(cuid())
  domain    String   @unique
  orgType   String   // "regulator"
  orgName   String   // "Central Bank of Kenya"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id                        String  @id @default(cuid())
  userId                    String  @unique
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Billing notifications (toggleable)
  paymentDueReminder        Boolean @default(true)

  // Compliance/system notifications (toggleable)
  complianceQueryReady      Boolean @default(true)
  policyDocumentReady       Boolean @default(true)
  documentIngestionComplete Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  REGULATOR
  STARTUP
  ENTERPRISE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PolicyStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  INDEXED
  FAILED
}

enum ContentType {
  REGULATORY_DOCUMENT
  BLOG_POST
  KNOWLEDGE_BASE_ARTICLE
  POLICY_TEMPLATE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNDER_REVIEW
}

enum NotificationType {
  POLICY_READY
  COMMENT_ADDED
  REVIEW_REQUESTED
  COMPLIANCE_ALERT
  SYSTEM_UPDATE
}

model RegulatoryDocument {
  id              String                     @id @default(cuid())
  title           String
  fileName        String
  fileType        String
  source          String
  category        RegulatoryDocumentCategory
  jurisdiction    String
  documentType    String
  effectiveDate   DateTime?
  version         String?
  storageKey      String
  status          RegulatoryDocumentStatus   @default(PENDING)
  checksum        String?
  chunkCount      Int?
  totalCharacters Int?
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  chunks          RegulatoryDocumentChunk[]

  @@index([status])
  @@index([category])
  @@index([jurisdiction])
  @@index([checksum])
}

model RegulatoryDocumentChunk {
  id         String             @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  section    String?
  tokenCount Int
  pineconeId String             @unique
  createdAt  DateTime           @default(now())
  document   RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum RegulatoryDocumentCategory {
  DATA_PROTECTION
  CYBERSECURITY
  FINTECH_REGULATION
  AML_CFT
  PAYMENT_SYSTEMS
  INTERNATIONAL_STANDARD
}

enum RegulatoryDocumentStatus {
  PENDING
  PROCESSING
  ACTIVE
  FAILED
  SUPERSEDED
}

// ============================================================================
// Compliance Dashboard Models
// ============================================================================

enum ComplianceCategory {
  DATA_PROTECTION
  AML_KYC
  CONSUMER_PROTECTION
  CBK_LICENSING
  CYBERSECURITY
}

model ComplianceItem {
  id             String             @id @default(cuid())
  organizationId String
  category       ComplianceCategory
  title          String
  description    String
  isCompleted    Boolean            @default(false)
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
}

// ============================================================================
// Query Feedback + Saved Responses
// ============================================================================

model QueryFeedback {
  id        String          @id @default(cuid())
  queryId   String
  userId    String
  rating    String          // "up" | "down"
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  query     ComplianceQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queryId, userId])
  @@index([userId])
  @@index([queryId])
}

model SavedResponse {
  id        String          @id @default(cuid())
  queryId   String
  userId    String
  notes     String?
  createdAt DateTime        @default(now())
  query     ComplianceQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queryId, userId])
  @@index([userId])
  @@index([queryId])
}

model ComplianceScoreSnapshot {
  id                    String   @id @default(cuid())
  organizationId        String
  overallScore          Float
  dataProtectionScore   Float
  amlKycScore           Float
  consumerProtectionScore Float
  cbkLicensingScore     Float
  cybersecurityScore    Float
  calculatedAt          DateTime @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, calculatedAt])
}

// ============================================================================
// Document Vault Models
// ============================================================================

enum DocumentCategory {
  CORPORATE
  COMPLIANCE
  FINANCIAL
  LICENSE
  OPERATIONS
  TAX
  OTHER
}

enum VaultDocumentStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model VaultDocument {
  id             String              @id @default(cuid())
  name           String
  description    String?
  fileName       String
  fileType       String
  fileExtension  String
  fileSize       Int
  storageKey     String
  category       DocumentCategory
  status         VaultDocumentStatus @default(PENDING)
  expiryDate     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  uploadedById   String
  organizationId String
  tags           String[]            @default([])
  version        Int                 @default(1)
  isArchived     Boolean             @default(false)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([uploadedById])
  @@index([category])
  @@index([status])
  @@index([organizationId, category])
  @@index([organizationId, status])
}
