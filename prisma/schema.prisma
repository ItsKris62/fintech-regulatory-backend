  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  consentRecords   ConsentRecord[]
  listMemberships  ContactListMembership[]
  campaignSends    CampaignSend[]
  pilotInvitations PilotInvitation[]

  @@index([email])
  @@index([companyId])
  @@index([consentStatus])
  @@index([suppressedAt])
  @@index([createdById])
  @@index([deletedAt])
}

model ContactList {
  id             String                  @id @default(cuid())
  name           String                  @unique
  description    String?
  isDynamic      Boolean                 @default(false)
  filterCriteria Json?
  createdById    String
  createdBy      User                    @relation("ContactListCreatedBy", fields: [createdById], references: [id])
  memberships    ContactListMembership[]
  campaigns      MarketingCampaign[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
