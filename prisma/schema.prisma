generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}

model User {
  id                       String                   @id @default(cuid())
  supabaseAuthId           String?                  @unique
  email                    String                   @unique
  password                 String?   // nullable — Supabase is the authoritative credential store
  fullName                 String
  phone                    String?
  avatar                   String?
  role                     UserRole
  status                   UserStatus               @default(PENDING_VERIFICATION)
  accountStatus            String                   @default("pending") // "pending" | "active" | "suspended" | "rejected" | "pending_approval"
  emailVerified            Boolean                  @default(false)
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?                  @unique
  emailVerificationExpiry  DateTime?
  passwordResetToken       String?                  @unique
  passwordResetExpiry      DateTime?
  organizationId           String?
  lastLoginAt              DateTime?
  lastLoginIp              String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  preferences              Json?
  totpEnabled              Boolean                  @default(false)
  totpSecret               String?
  apiKeys                  ApiKey[]
  auditLogs                AuditLog[]
  checklists               Checklist[]
  gapAnalyses              GapAnalysis[]
  complianceQueries        ComplianceQuery[]
  authoredDocuments        LegalDocument[]          @relation("DocumentAuthor")
  publishedDocuments       LegalDocument[]          @relation("DocumentPublisher")
  vaultDocuments           VaultDocument[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference?
  categoryPreferences      NotificationCategoryPreference[]
  policies                 Policy[]
  sessions                 Session[]
  organization             Organization?            @relation(fields: [organizationId], references: [id])
  queryFeedbacks           QueryFeedback[]
  savedResponses           SavedResponse[]
  supportTickets           SupportTicket[]
  ticketComments           TicketComment[]

  // Free trial fields (one-time, user-scoped -- not org-scoped)
  freeTrialActivatedAt     DateTime?
  freeTrialExpiresAt       DateTime?
  freeTrialUsage           Json?       // TrialUsage: { complianceQueries, gapAnalyses, checklists, vaultUploads, totalTokensUsed }

  @@index([email])
  @@index([supabaseAuthId])
  @@index([organizationId])
  @@index([role])
  @@index([accountStatus])
}

model Organization {
  id                 String           @id @default(cuid())
  name               String
  type               String
  organizationType   String           @default("startup") // "regulator" | "startup" | "enterprise"
  registrationNumber String?
  cbkLicenseNumber   String?
  website            String?
  industry           String?
  size               String?
  subscriptionTier   String           @default("starter")
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  trialEndsAt        DateTime?
  gracePeriodEndsAt  DateTime?          // set on cancellation; org keeps plan until this passes
  cancelledAt        DateTime?          // when the user initiated cancellation
  subscriptionEndsAt DateTime?
  verificationStatus String           @default("pending") // "pending" | "verified" | "rejected"
  verifiedAt         DateTime?
  verifiedBy         String?
  // Plan entitlements (new — additive)
  plan               SubscriptionPlan @default(REGULATOR)
  planStartDate      DateTime?
  planEndDate        DateTime?
  maxSeats           Int              @default(1)
  stripeCustomerId   String?          @unique
  stripeSubId        String?          @unique
  customLimits       Json?
  // M-Pesa / IntaSend payment fields
  preferredPaymentMethod  PaymentProvider? // STRIPE | MPESA; null = Stripe default
  mpesaPhoneNumber        String?          // stored as 254XXXXXXXXX
  mpesaNextPaymentDueDate DateTime?        // set on each successful M-Pesa payment; lazy-evaluated for renewal
  // Contact Information — Primary contact for regulatory matters
  address            String?
  contactPerson      String?
  contactPosition    String?
  contactEmail       String?
  contactPhone       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  users                   User[]
  complianceItems         ComplianceItem[]
  complianceSnapshots     ComplianceScoreSnapshot[]
  complianceEvents        ComplianceEvent[]
  vaultDocuments          VaultDocument[]
  usageRecords            UsageRecord[]
  usagePeriods            UsagePeriod[]
  payments                Payment[]

  @@index([name])
  @@index([verificationStatus])
  @@index([plan])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  device       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Policy {
  id                     String       @id @default(cuid())
  userId                 String
  scenario               String
  regulatoryAreas        String[]
  urgency                String
  stakeholders           String[]
  title                  String?
  executiveSummary       String?
  analysis               String?
  recommendations        Json?
  complianceChecklist    Json?
  implementationTimeline Json?
  appendices             Json?
  status                 PolicyStatus @default(DRAFT)
  generationTime         Int?
  version                Int          @default(1)
  assignedTo             String?
  reviewers              String[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  citations              Citation[]
  comments               Comment[]
  user                   User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Citation {
  id          String         @id @default(cuid())
  policyId    String
  actName     String
  section     String
  subsection  String?
  textSnippet String
  confidence  String
  verified    Boolean        @default(false)
  documentId  String?
  createdAt   DateTime       @default(now())
  document    LegalDocument? @relation(fields: [documentId], references: [id])
  policy      Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([documentId])
}

model Comment {
  id        String   @id @default(cuid())
  policyId  String
  userId    String
  content   String
  resolved  Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model LegalDocument {
  id               String          @id @default(cuid())
  actName          String
  documentType     String
  enactmentDate    DateTime?
  effectiveDate    DateTime?
  amendedBy        String[]
  regulatoryBody   String?
  originalFilename String
  fileUrl          String
  fileSize         Int
  mimeType         String
  status           DocumentStatus  @default(UPLOADING)
  totalChunks      Int?
  processedAt      DateTime?
  fullText         String?
  summary          String?
  keywords         String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  authorId         String?
  category         String?
  content          String?
  contentStatus    ContentStatus   @default(DRAFT)
  contentType      ContentType     @default(REGULATORY_DOCUMENT)
  deletedAt        DateTime?
  excerpt          String?
  helpfulCount     Int             @default(0)
  htmlContent      String?
  isLatestVersion  Boolean         @default(true)
  notHelpfulCount  Int             @default(0)
  organizationId   String?
  parentId         String?
  publishedAt      DateTime?
  publishedBy      String?
  seoDescription   String?
  seoKeywords      String[]        @default([])
  seoTitle         String?
  slug             String?         @unique
  subcategory      String?
  tags             String[]        @default([])
  title            String?
  userId           String?
  version          Int             @default(1)
  viewCount        Int             @default(0)
  citations        Citation[]
  chunks           DocumentChunk[]
  shares           DocumentShare[]
  author           User?           @relation("DocumentAuthor", fields: [authorId], references: [id])
  parent           LegalDocument?  @relation("DocumentVersions", fields: [parentId], references: [id])
  versions         LegalDocument[] @relation("DocumentVersions")
  publisher        User?           @relation("DocumentPublisher", fields: [publishedBy], references: [id])

  @@index([actName])
  @@index([status])
  @@index([contentType, contentStatus])
  @@index([slug])
  @@index([category, subcategory])
  @@index([organizationId, contentType])
  @@index([authorId])
}

model DocumentChunk {
  id            String        @id @default(cuid())
  documentId    String
  chunkIndex    Int
  sectionNumber String?
  subsection    String?
  text          String
  embedding     Float[]
  wordCount     Int
  createdAt     DateTime      @default(now())
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sectionNumber])
}

model ComplianceQuery {
  id               String   @id @default(cuid())
  userId           String
  organizationId   String?
  query            String
  response         String?
  citations        Json?
  regulatoryAreas  Json?
  confidence       Float?
  recommendations  Json?
  processingTimeMs Int?
  metadata         Json?
  productCategory  String?
  summary          String?
  regulations      Json?
  requirements     Json?
  gaps             Json?
  status           String   @default("processing")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  feedbacks        QueryFeedback[]
  saves            SavedResponse[]

  @@index([userId])
  @@index([createdAt])
  @@index([organizationId])
  @@index([status])
}

model Checklist {
  id                 String          @id @default(cuid())
  userId             String
  organizationId     String?
  title              String
  productType        String?
  businessStage      String?
  targetSegments     Json?
  servicesOffered    Json?
  additionalConcerns String?
  description        String?
  items              Json
  checklistData      Json?
  itemProgress       Json?
  progress           Int             @default(0)
  completedItems     Int             @default(0)
  totalItems         Int             @default(0)
  summary            Json?
  metadata           Json?
  generatedAt        DateTime?
  status             String          @default("GENERATING")
  dueDate            DateTime?
  completedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id])
  checklistItems     ChecklistItem[]

  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@index([deletedAt])
}

model ChecklistItem {
  id                  String    @id @default(cuid())
  checklistId         String
  category            String
  itemCode            String?
  title               String
  description         String
  guidance            String?
  regulatoryReference String
  actionItems         Json      // String[] stored as JSON array
  deadline            String?
  penalty             String?
  priority            String    // CRITICAL | HIGH | MEDIUM | LOW
  status              String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | NOT_APPLICABLE
  notes               String?
  order               Int       @default(0)
  completedAt         DateTime?
  completedById       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  checklist           Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([checklistId, category])
  @@index([checklistId, status])
  @@index([priority])
}

model GapAnalysis {
  id                   String    @id @default(cuid())
  userId               String
  organizationId       String?
  documentName         String
  documentUrl          String
  documentType         String
  regulatoryFrameworks Json
  analysisDepth        String    @default("standard")
  focusAreas           Json?
  results              Json?
  overallScore         Int?
  status               String    @default("UPLOADING")
  progress             Int       @default(0)
  errorMessage         String?
  ragGrounded          Boolean   @default(true)
  chunksProcessed      Int       @default(1)
  reportUrl            String?
  reportGeneratedAt    DateTime?
  completedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  category  NotificationCategory @default(SYSTEM)
  title     String
  message   String
  link      String?
  read      Boolean              @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime             @default(now())
  eventId   String?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     ComplianceEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read, createdAt])
  @@index([userId, category, createdAt])
  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  key        String    @unique
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model UsageMetric {
  id                String   @id @default(cuid())
  date              DateTime
  organizationId    String?
  userId            String?
  policiesGenerated Int      @default(0)
  queriesProcessed  Int      @default(0)
  avgGenerationTime Float?
  citationAccuracy  Float?

  @@unique([date, organizationId, userId])
  @@index([date])
  @@index([organizationId])
}

model DocumentShare {
  id           String        @id @default(cuid())
  documentId   String
  token        String        @unique
  sharedBy     String
  expiresAt    DateTime?
  maxDownloads Int?
  downloads    Int           @default(0)
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  document     LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([token])
  @@index([sharedBy])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  userId     String?
  orgId      String?
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([orgId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  category    String   @default("feature") // "system" | "billing" | "feature" | "experiment"
  metadata    Json?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([name])
  @@index([category])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string") // "string" | "number" | "boolean" | "json"
  category    String   @default("general") // "general" | "security" | "ai" | "storage" | "email" | "billing"
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([category])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  success       Boolean
  ipAddress     String?
  userAgent     String?
  failureReason String?
  location      String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@index([success])
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  role           String    // Target role: REGULATOR, STARTUP, ENTERPRISE
  token          String    @unique
  expiresAt      DateTime
  used           Boolean   @default(false)
  usedAt         DateTime?
  invitedBy      String    // Admin user ID
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([token])
}

model EmailDomainWhitelist {
  id        String   @id @default(cuid())
  domain    String   @unique
  orgType   String   // "regulator"
  orgName   String   // "Central Bank of Kenya"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id                        String  @id @default(cuid())
  userId                    String  @unique
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // General Email Notifications
  regulatoryUpdates         Boolean @default(true)
  deadlineReminders         Boolean @default(true)
  reportReady               Boolean @default(true)
  supportResponses          Boolean @default(true)

  // In-App Notifications
  realTimeAlerts            Boolean @default(true)

  // Email Digest
  emailDigestEnabled        Boolean @default(false)
  digestFrequency           String  @default("weekly") // "daily" | "weekly" | "monthly"

  // Billing notifications (toggleable)
  paymentDueReminder        Boolean @default(true)

  // Compliance/system notifications (toggleable)
  complianceQueryReady      Boolean @default(true)
  policyDocumentReady       Boolean @default(true)
  documentIngestionComplete Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  REGULATOR
  STARTUP
  ENTERPRISE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PolicyStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  INDEXED
  FAILED
}

enum ContentType {
  REGULATORY_DOCUMENT
  BLOG_POST
  KNOWLEDGE_BASE_ARTICLE
  POLICY_TEMPLATE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNDER_REVIEW
}

enum NotificationType {
  // ── Existing (all callers preserved) ──────────────────────────────────────
  POLICY_READY
  COMMENT_ADDED
  REVIEW_REQUESTED
  COMPLIANCE_ALERT
  SYSTEM_UPDATE
  TICKET_CREATED
  TICKET_STATUS_UPDATE
  TICKET_RESPONSE

  // ── Security events ────────────────────────────────────────────────────────
  PASSWORD_CHANGED
  PASSWORD_CHANGE_FAILED
  LOGIN_NEW_DEVICE

  // ── Compliance events ──────────────────────────────────────────────────────
  CHECKLIST_GENERATED
  CHECKLIST_COMPLETED
  GAP_ANALYSIS_STARTED
  GAP_ANALYSIS_COMPLETED

  // ── Document vault ────────────────────────────────────────────────────────
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED

  // ── Account events ────────────────────────────────────────────────────────
  PROFILE_UPDATED
  ORGANIZATION_UPDATED
  SUBSCRIPTION_CHANGED
  SUBSCRIPTION_EXPIRING

  // ── Support tickets ───────────────────────────────────────────────────────
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_UPDATED

  // ── System ────────────────────────────────────────────────────────────────
  SYSTEM_ANNOUNCEMENT

  // ── Calendar events ───────────────────────────────────────────────────────
  EVENT_CREATED
  EVENT_REMINDER
}

enum NotificationCategory {
  SECURITY    // Password changes, login alerts, and security events
  COMPLIANCE  // Checklists, gap analysis, policy docs
  DOCUMENTS   // Vault uploads, deletions, and vault activity
  ACCOUNT     // Profile changes, organization updates, and subscription events
  SUPPORT     // Support ticket creation and status updates
  SYSTEM      // Platform announcements and maintenance notices
}

model NotificationCategoryPreference {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  inAppEnabled Boolean              @default(true)
  emailEnabled Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

// ============================================================================
// Support Ticket System
// ============================================================================

enum TicketCategory {
  BILLING
  TECHNICAL
  COMPLIANCE_QUERY
  ACCOUNT
  FEATURE_REQUEST
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  description  String          @db.Text
  category     TicketCategory
  priority     TicketPriority  @default(MEDIUM)
  status       TicketStatus    @default(OPEN)
  comments     TicketComment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  closedAt     DateTime?

  @@index([userId])
  @@index([status])
  @@index([ticketNumber])
  @@index([createdAt])
}

model TicketComment {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String        @db.Text
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@index([ticketId, createdAt])
}

model RegulatoryDocument {
  id              String                     @id @default(cuid())
  title           String
  fileName        String
  fileType        String
  source          String
  category        RegulatoryDocumentCategory
  jurisdiction    String
  documentType    String
  effectiveDate   DateTime?
  version         String?
  storageKey      String
  status          RegulatoryDocumentStatus   @default(PENDING)
  checksum        String?
  chunkCount      Int?
  totalCharacters Int?
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  chunks          RegulatoryDocumentChunk[]

  @@index([status])
  @@index([category])
  @@index([jurisdiction])
  @@index([checksum])
}

model RegulatoryDocumentChunk {
  id         String             @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  section    String?
  tokenCount Int
  pineconeId String             @unique
  createdAt  DateTime           @default(now())
  document   RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum RegulatoryDocumentCategory {
  DATA_PROTECTION
  CYBERSECURITY
  FINTECH_REGULATION
  AML_CFT
  PAYMENT_SYSTEMS
  INTERNATIONAL_STANDARD
}

enum RegulatoryDocumentStatus {
  PENDING
  PROCESSING
  ACTIVE
  FAILED
  SUPERSEDED
}

// ============================================================================
// Compliance Dashboard Models
// ============================================================================

enum ComplianceCategory {
  DATA_PROTECTION
  AML_KYC
  CONSUMER_PROTECTION
  CBK_LICENSING
  CYBERSECURITY
}

model ComplianceItem {
  id             String             @id @default(cuid())
  organizationId String
  category       ComplianceCategory
  title          String
  description    String
  isCompleted    Boolean            @default(false)
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
}

// ============================================================================
// Query Feedback + Saved Responses
// ============================================================================

model QueryFeedback {
  id        String          @id @default(cuid())
  queryId   String
  userId    String
  rating    String          // "up" | "down"
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  query     ComplianceQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queryId, userId])
  @@index([userId])
  @@index([queryId])
}

model SavedResponse {
  id        String          @id @default(cuid())
  queryId   String
  userId    String
  notes     String?
  createdAt DateTime        @default(now())
  query     ComplianceQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queryId, userId])
  @@index([userId])
  @@index([queryId])
}

model ComplianceScoreSnapshot {
  id                    String   @id @default(cuid())
  organizationId        String
  overallScore          Float
  dataProtectionScore   Float
  amlKycScore           Float
  consumerProtectionScore Float
  cbkLicensingScore     Float
  cybersecurityScore    Float
  calculatedAt          DateTime @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, calculatedAt])
}

// ============================================================================
// Document Vault Models
// ============================================================================

enum DocumentCategory {
  CORPORATE
  COMPLIANCE
  FINANCIAL
  LICENSE
  OPERATIONS
  TAX
  OTHER
}

enum VaultDocumentStatus {
  PENDING
  VERIFIED
  EXPIRED
}

// ============================================================================
// Plan Entitlements & Usage Metering
// ============================================================================

enum SubscriptionStatus {
  ACTIVE        // Subscription is current and paid
  TRIALING      // Within the 14-day free trial window
  PAST_DUE      // Payment failed; Stripe is retrying
  CANCELLED     // Stripe subscription deleted; immediately enters GRACE_PERIOD
  GRACE_PERIOD  // Cancelled but within the 7-day grace window; full access retained
  EXPIRED       // Grace period elapsed; plan has been downgraded to REGULATOR
}

enum SubscriptionPlan {
  REGULATOR
  STARTUP
  BUSINESS
  ENTERPRISE
}

enum BillingMetric {
  COMPLIANCE_QUERIES
  CHECKLIST_GENERATIONS
  API_CALLS
  DOCUMENT_STORAGE_MB
  GAP_ANALYSES
  POLICY_GENERATIONS
}

model UsageRecord {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  metric         BillingMetric
  count          Int             @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric])
}

// ============================================================================
// Usage Period — durable per-org monthly usage snapshots with plan limits
// Source of truth for historical comparison; Redis counters are real-time truth.
// Period boundaries are calendar months in EAT (UTC+3).
// ============================================================================

model UsagePeriod {
  id             String   @id @default(cuid())
  organizationId String

  // Period boundaries stored as UTC equivalents of EAT calendar-month boundaries.
  // periodStart = 1st of month 00:00:00 EAT expressed in UTC.
  // periodEnd   = last day of month 23:59:59.999 EAT expressed in UTC.
  periodStart    DateTime
  periodEnd      DateTime

  // ---- Usage counters (synced lazily from Redis on each dashboard read) ----
  complianceQueries    Int   @default(0)
  checklistGenerations Int   @default(0)
  apiCalls             Int   @default(0)
  documentStorageMb    Float @default(0)
  gapAnalyses          Int   @default(0)
  policyGenerations    Int   @default(0)

  // ---- Plan snapshot (captured at period creation / plan upgrade) ----------
  // Limits use the same convention as PLAN_ENTITLEMENTS:
  //   -1 = unlimited,  0 = unavailable/feature not in plan,  n = monthly cap
  planTier                 String // "REGULATOR" | "STARTUP" | "BUSINESS" | "ENTERPRISE"
  complianceQueryLimit     Int
  checklistGenerationLimit Int
  apiCallLimit             Int
  documentStorageMbLimit   Float
  gapAnalysisLimit         Int    // boolean features: -1 = enabled, 0 = disabled
  policyGenerationLimit    Int    // boolean features: -1 = enabled, 0 = disabled

  // ---- Audit ---------------------------------------------------------------
  syncedFromRedisAt DateTime? // Last time counters were synced from Redis
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart])
  @@index([organizationId, periodStart])
  @@index([periodStart, periodEnd])
}

// ============================================================================
// Payment History
// ============================================================================

enum PaymentProvider {
  STRIPE
  MPESA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id                    String          @id @default(cuid())
  orgId                 String
  org                   Organization    @relation(fields: [orgId], references: [id])
  subscriptionId        String?
  provider              PaymentProvider
  providerTransactionId String?
  amount                Int             // smallest currency unit (e.g. KES cents)
  currency              String          @default("KES")
  status                PaymentStatus   @default(PENDING)
  description           String?
  paidAt                DateTime?
  metadata              Json?           // provider-specific data (invoice URL, etc.)
  // Invoice fields (generated at payment creation time)
  invoiceNumber         String?         @unique // SB-{YYYY}-{00000}
  subscriptionPlan      String?                 // plan name at time of payment (e.g. "STARTUP")
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([providerTransactionId])
  @@index([invoiceNumber])
}

// ============================================================================
// Compliance Calendar
// ============================================================================

model ComplianceEvent {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  dueDate        DateTime
  priority       String    @default("MEDIUM")   // LOW | MEDIUM | HIGH | CRITICAL
  status         String    @default("UPCOMING") // UPCOMING | IN_PROGRESS | COMPLETED | OVERDUE
  category       String    @default("CUSTOM")   // CUSTOM | FILING | AUDIT | RENEWAL | REVIEW
  regulation     String?
  recurrence     String?   @default("NONE")     // NONE | MONTHLY | QUARTERLY | ANNUALLY
  assigneeId     String?
  createdById    String
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([organizationId])
  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@unique([organizationId, title, dueDate])
}

model VaultDocument {
  id             String              @id @default(cuid())
  name           String
  description    String?
  fileName       String
  fileType       String
  fileExtension  String
  fileSize       Int
  storageKey     String
  category       DocumentCategory
  status         VaultDocumentStatus @default(PENDING)
  expiryDate     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  uploadedById   String
  organizationId String
  tags           String[]            @default([])
  version        Int                 @default(1)
  isArchived     Boolean             @default(false)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([uploadedById])
  @@index([category])
  @@index([status])
  @@index([organizationId, category])
  @@index([organizationId, status])
}

model RegulatoryFramework {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String?
  tier        String   @default("STARTUP")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
