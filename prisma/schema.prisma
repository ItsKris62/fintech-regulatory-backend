  @@index([name])
  @@index([createdById])
  @@index([deletedAt])
}

model Contact {
  id                String               @id @default(cuid())
  companyId         String?
  company           Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  email             String               @unique
  firstName         String?
  lastName          String?
  role              String?
  phone             String?
  primaryRegulator  String?
  tags              String[]             @default([])
  notes             String?
  consentStatus     ContactConsentStatus @default(PENDING)
  consentSource     String?
  consentTimestamp  DateTime?
  suppressedAt      DateTime?
