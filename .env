# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Resend Email (Free Tier)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307
# Options: claude-3-opus, claude-3-sonnet, claude-3-haiku

# Vector Database (Choose one)
# Option 1: Pinecone (Free tier: 1 index, 100k vectors)
PINECONE_API_KEY=pcsk_PS2Sb_QvAowbcC72xtXRCE5m2patHeQ6hhGqKyNKSkgv2KZNGuLH6aLNks9Pp7t7wG6AK
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=sheriabot-legal-corpus

# Option 2: Chroma (Free, self-hosted on Railway)
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Cloudflare R2 (File Storage)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=sheriabot-documents
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Redis (Railway Redis - for caching & queues)
REDIS_URL=redis://default:password@host:port

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Stripe (For future - Phase 2)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# M-PESA Daraja API (For future - Phase 2)
# MPESA_CONSUMER_KEY=your-consumer-key
# MPESA_CONSUMER_SECRET=your-consumer-secret
# MPESA_PASSKEY=your-passkey
# MPESA_SHORTCODE=174379
# MPESA_ENVIRONMENT=sandbox