# ==============================================================
# SheriaBot API - Environment Variables
# ==============================================================
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file - it contains secrets.

#  Application
NODE_ENV=development                    # development | production | test
PORT=4000                               # Server port
APP_URL=http://localhost:4000            # Full URL of this API
FRONTEND_URL=http://localhost:3000       # Frontend app URL (for CORS)
LOG_LEVEL=info                           # fatal | error | warn | info | debug | trace

#  Sentry (error tracking and low-rate tracing)
# Leave blank in local development if you do not want Sentry events.
SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000
SENTRY_TRACES_SAMPLE_RATE=0.01

#  Database (Supabase PostgreSQL)
# Use the pooled connection URL (port 6543) for the app (pgBouncer)
# Get from: Supabase dashboard  Settings  Database  Connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (port 5432)  used only for Prisma migrations
# Get from: Supabase dashboard  Settings  Database  Connection string (Direct)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

#  Upstash Redis (caching, rate limiting, session store)
# Get from: https://console.upstash.com  Create Database  REST API
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

#  Supabase Auth
# Get from: Supabase dashboard  Settings  API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Get JWT secret from: Supabase dashboard  Settings  API  JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

#  Email (Resend  https://resend.com)
# Free tier: 100 emails/day, 3000/month
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com        # Must be verified in Resend
SUPPORT_EMAIL_RECIPIENT=support@sheriabot.com  # Inbox that receives new ticket notifications

#  AI (Anthropic Claude  https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

#  Vector Database (Pinecone  https://www.pinecone.io)
# Free tier: 1 index, 100k vectors
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws       # Your Pinecone region
PINECONE_INDEX_NAME=sheriabot-legal-docs

#  Analytics (PostHog  https://posthog.com)  optional, read-only
# Used only by the sales/growth agent's engagement lookup (HogQL query API).
# POSTHOG_PERSONAL_API_KEY must be a query-scoped Personal API Key, not a
# project capture key. Leave blank to disable engagement lookups (agent
# degrades gracefully with no engagement claims in drafted outreach copy).
# POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here
# POSTHOG_HOST=https://us.posthog.com
# POSTHOG_PROJECT_ID=your-project-id

#  File Storage (Cloudflare R2  https://dash.cloudflare.com)
# Free tier: 10 GB storage, 10M reads, 1M writes/month
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sheria-bot-saas
R2_PUBLIC_URL=https://your-account-id.r2.cloudflarestorage.com
# Vault storage uses a separate bucket-scoped R2 credential.
R2_VAULT_BUCKET=sheriabot-storage
R2_VAULT_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_VAULT_ACCESS_KEY_ID=your-vault-bucket-scoped-access-key-id
R2_VAULT_SECRET_ACCESS_KEY=your-vault-bucket-scoped-secret-access-key
# Non-development vault uploads fail closed unless ClamAV is enabled and reachable.
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

#  Rate Limiting
RATE_LIMIT_MAX=100                       # Max requests per window
RATE_LIMIT_WINDOW=15m                    # Rate limit window duration

#  Admin Seed (optional  used by npm run db:seed:prod)
# ADMIN_EMAIL=admin@sheriabot.com
# ADMIN_PASSWORD=StrongPassword123!

#  Stripe Payments
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_* / pk_test_* in development; sk_live_* / pk_live_* in production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook signing secret  from: Stripe Dashboard  Developers  Webhooks  your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Stripe Price IDs  create in Stripe Dashboard  Products
STRIPE_PRICE_STARTUP_MONTHLY=price_your_startup_monthly_price_id
STRIPE_PRICE_BUSINESS_MONTHLY=price_your_business_monthly_price_id

#  IntaSend (M-Pesa)
# Get from: https://developers.intasend.com  API Keys
# Use test keys in development; switch to live keys in production
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_your_publishable_key_here
INTASEND_SECRET_KEY=ISSecretKey_test_your_secret_key_here
INTASEND_IS_TEST=true                    # Set to false in production
INTASEND_WEBHOOK_CHALLENGE=generate_a_long_random_webhook_challenge
INTASEND_WEBHOOK_URL=https://api.example.com/api/webhooks/intasend
INTASEND_PLAN_STARTUP_MONTHLY=your_startup_monthly_plan_id
INTASEND_PLAN_STARTUP_YEARLY=your_startup_yearly_plan_id
INTASEND_PLAN_BUSINESS_MONTHLY=your_business_monthly_plan_id
INTASEND_PLAN_BUSINESS_YEARLY=your_business_yearly_plan_id

#  Public R2 bucket (branding assets)
R2_PUBLIC_ACCESS_KEY_ID=your-r2-public-access-key-id
R2_PUBLIC_SECRET_ACCESS_KEY=your-r2-public-secret-key
R2_PUBLIC_BUCKET_NAME=sheria-bot-public
R2_PUBLIC_BUCKET_URL=https://pub-your-account-hash.r2.dev

#  Marketing & Outreach Module
# From address for marketing/campaign emails (must be verified in Resend)
RESEND_MARKETING_FROM_EMAIL=marketing@sheriabot.com
# Display name shown in the "From" field of marketing emails
RESEND_MARKETING_FROM_NAME=SheriaBot
# Svix signing secret for Resend webhooks  get from Resend dashboard  Webhooks  your endpoint
# Minimum 32 characters
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret-min-32-chars
# HMAC secret for unsubscribe/consent tokens embedded in emails
# Minimum 64 characters  generate with: openssl rand -hex 32
MARKETING_TOKEN_HMAC_SECRET=your-marketing-token-hmac-secret-min-64-chars-generate-with-openssl-rand-hex-32
# Public-facing URL used in email links (unsubscribe, pilot application, etc.)
APP_PUBLIC_URL=https://app.sheriabot.com
# Email address that receives internal admin notifications (pilot apps, alerts, etc.)
ADMIN_NOTIFICATION_EMAIL=hello@sheriabot.com
# How many days a pilot invitation link remains valid before expiry (190)
PILOT_INVITATION_EXPIRY_DAYS=14

#  Vault Reconciliation Cron
# When true (default), the nightly cron logs orphans but does not delete anything.
# Review dry-run logs for at least 2 nights, then flip to false to enable real deletions.
VAULT_RECONCILIATION_DRY_RUN=true
# Optional expensive integrity mode: recompute SHA-256 for active vault objects.
VAULT_RECONCILIATION_VERIFY_HASHES=false
# Soft-deleted vault objects are purged after this many days by vault:cleanup-deleted.
VAULT_DELETED_RETENTION_DAYS=30

#  REMOVED (Railway  Supabase/Upstash migration)
# REDIS_URL           replaced by UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# JWT_SECRET          replaced by SUPABASE_JWT_SECRET (Supabase issues JWTs)
# JWT_EXPIRES_IN      managed by Supabase Auth settings
# REFRESH_TOKEN_SECRET     managed by Supabase Auth
# REFRESH_TOKEN_EXPIRES_IN  managed by Supabase Auth
