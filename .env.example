# ╔══════════════════════════════════════════════════════════════╗
# ║          SheriaBot API — Environment Variables               ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.

# ── Application ─────────────────────────────────────────────────
NODE_ENV=development                    # development | production | test
PORT=4000                               # Server port (Railway sets this automatically)
APP_URL=http://localhost:4000            # Full URL of this API
FRONTEND_URL=http://localhost:3000       # Frontend app URL (for CORS)
LOG_LEVEL=info                           # fatal | error | warn | info | debug | trace

# ── Database (PostgreSQL via Railway) ───────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/sheriabot"

# ── Redis (Railway Redis — caching, rate limiting, queues) ──────
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:yMQBsDGtkKiwSJAgUtolksANAQqTGatc@gondola.proxy.rlwy.net:46183


# ── JWT Authentication ──────────────────────────────────────────
# IMPORTANT: Generate strong random strings (min 32 chars)
#   openssl rand -base64 48
JWT_SECRET=64635d979a7190fce11b997793be584b8242a24082794a56cd273896d70f5f0c
JWT_EXPIRES_IN=7d                        # Access token lifetime
REFRESH_TOKEN_SECRET=ab713c0c20cc3023903a8fd4bb078e41ca1b67133cffaaf188f5cdbd7daba432
REFRESH_TOKEN_EXPIRES_IN=30d             # Refresh token lifetime

# ── Email (Resend — https://resend.com) ─────────────────────────
# Free tier: 100 emails/day, 3000/month
RESEND_API_KEY=re_c2F8eeem_PishPyp8VG2f4HopcuXjjwsU
FROM_EMAIL=noreply@yourdomain.com        # Must be verified in Resend

# ── AI (Anthropic Claude — https://console.anthropic.com) ──────
# Free tier: $5 credit on signup
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307  # claude-3-haiku | claude-3-sonnet | claude-3-opus

# ── Vector Database (Pinecone — https://www.pinecone.io) ───────
# Free tier: 1 index, 100k vectors
PINECONE_API_KEY=pcsk_3QbPGX_E5NezWuoQ2GxWEowB1MN4eUKbZQoyxvoAy2MqnNNxpEdfXdX3cajFHaLdo4roJd
PINECONE_ENVIRONMENT=us-east-1-aws       # Your Pinecone region
PINECONE_INDEX_NAME=sheriabot-legal-docs

# ── File Storage (Cloudflare R2 — https://dash.cloudflare.com) ─
# Free tier: 10 GB storage, 10M reads, 1M writes/month
R2_ACCOUNT_ID=7b7ba84d7010f40c5f177df52f5e3082
R2_ACCESS_KEY_ID=73e9ffb0333b11eb837d5f0ae0e72877
R2_SECRET_ACCESS_KEY=09f3c34a926caeded1a960694be79295f561c65a842c8ac6a5a131a52452530a
R2_BUCKET_NAME=sheria-bot-saas
R2_PUBLIC_URL=https://7b7ba84d7010f40c5f177df52f5e3082.r2.cloudflarestorage.com  # Public bucket URL

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_MAX=100                       # Max requests per window
RATE_LIMIT_WINDOW=15m                    # Rate limit window duration

# ── Admin Seed (optional — used by npm run db:seed:prod) ────────
# ADMIN_EMAIL=admin@sheriabot.co.ke
# ADMIN_PASSWORD=StrongPassword123!

# ── Future: Payments (Phase 2) ──────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MPESA_CONSUMER_KEY=your_consumer_key
# MPESA_CONSUMER_SECRET=your_consumer_secret
