// ============================================================================
// DOCUMENT SHARING
// ============================================================================

model DocumentShare {
  id         String        @id @default(cuid())
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  token      String        @unique
  sharedBy   String

  expiresAt    DateTime?
  maxDownloads Int?
  downloads    Int       @default(0)
  revokedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([token])
  @@index([sharedBy])
}

// ============================================================================
// ANALYTICS EVENTS
// ============================================================================

model AnalyticsEvent {
  id String @id @default(cuid())

  event      String
  userId     String?
  orgId      String?
  resourceId String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([orgId])
  @@index([createdAt])
}

// ============================================================================
// ADMIN: FEATURE FLAGS & SYSTEM CONFIG
// ============================================================================

model FeatureFlag {
  id          String  @id @default(cuid())
  name        String  @unique
  enabled     Boolean @default(false)
  description String?
  updatedBy   String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([name])
}

model SystemConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String  @db.Text
  description String?
  updatedBy   String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}
