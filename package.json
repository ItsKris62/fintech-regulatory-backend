  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.prod.json || true && tsc-alias -p tsconfig.prod.json",
    "start": "node dist/index.js",
