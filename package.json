    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^2.10.0",
    "@opentelemetry/api": "^1.9.0",
    "@pinecone-database/pinecone": "^7.0.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.0",
    "@react-email/components": "^1.0.8",
    "@sentry/node": "^10.55.0",
    "@supabase/supabase-js": "^2.99.0",
    "@trpc/client": "^11.9.0",
    "@trpc/server": "^11.9.0",
    "@types/ws": "^8.18.1",
    "@upstash/redis": "^1.36.4",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
