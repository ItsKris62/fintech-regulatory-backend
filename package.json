{
  "name": "fintech-regulatory-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "build": "tsc",
    "api-types:prepare": "pnpm build && tsx src/scripts/prepare-api-types-package.ts",
    "build:prod": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "prestart:prod": "pnpm run db:migrate:prod",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed:prod": "tsx src/scripts/seed.ts && pnpm seed:frameworks",
    "ingest": "tsx src/scripts/ingest-documents.ts",
    "regdoc:authority": "tsx src/scripts/update-regulatory-document-authority.ts",
    "seed:domains": "tsx src/scripts/seed-domain-whitelist.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:frameworks": "tsx src/scripts/seed-regulatory-frameworks.ts",
    "cleanup:documents": "tsx src/scripts/cleanup-deleted-documents.ts",
    "verify:checklist": "tsx src/scripts/verify-checklist.ts",
    "verify:checklist:live": "tsx src/scripts/verify-checklist.ts --live",
    "verify:content-marketing-schema": "tsx src/scripts/verify-schema.ts",
    "verify:checklist:full": "tsx src/scripts/verify-checklist.ts --live --all-tiers",
    "pilot:provision": "tsx src/scripts/provision-pilot-testers.ts",
    "pilot:provision:dry": "tsx src/scripts/provision-pilot-testers.ts",
    "pilot:provision:execute": "tsx src/scripts/provision-pilot-testers.ts --execute",
    "pilot:cron": "tsx src/scripts/pilot-lifecycle-cron.ts",
    "pilot:backfill-access": "tsx src/scripts/backfill-pilot-access.ts",
    "pilot:backfill-access:execute": "tsx src/scripts/backfill-pilot-access.ts --execute",
    "softbounce:cron": "tsx src/scripts/soft-bounce-cron.ts",
    "bulksend:cron": "tsx src/scripts/bulk-send-cron.ts",
    "vault:cron": "tsx src/scripts/vault-reconciliation-cron.ts",
    "automation-approval-expiry:cron": "tsx src/scripts/automation-approval-expiry-cron.ts",
    "vault:cleanup-deleted": "tsx src/scripts/cleanup-deleted-vault-documents.ts",
    "seed:marketing:flags": "tsx src/scripts/seed-marketing-feature-flags.ts",
    "cron:cleanup-snapshots": "tsx src/scripts/cleanup-compliance-snapshots.ts",
    "backfill:compliance-snapshots": "tsx src/scripts/backfill-compliance-snapshots.ts",
    "cron:blog-source-discovery": "tsx src/scripts/blog-source-discovery-cron.ts",
    "editorial:backfill-human-review": "tsx src/scripts/backfill-editorial-human-review.ts --dry-run",
    "editorial:backfill-human-review:write": "tsx src/scripts/backfill-editorial-human-review.ts --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "corpus:validate": "tsx src/scripts/corpus/validate-manifest.ts",
    "corpus:inventory": "tsx src/scripts/corpus/inventory.ts",
    "corpus:discover": "tsx src/scripts/corpus/discover-sources.ts",
    "corpus:download": "tsx src/scripts/corpus/download-approved.ts",
    "corpus:intake": "tsx src/scripts/corpus/manual-intake.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
