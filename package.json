    "docx": "^9.6.1",
    "dotenv": "^17.2.4",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "file-type": "^21.3.0",
    "intasend-node": "^1.1.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "nanoid": "^5.1.6",
    "openai": "^6.45.0",
    "otplib": "^13.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.1",
    "rss-parser": "^3.13.0",
    "stripe": "^20.4.1",
    "ws": "^8.21.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "@xmldom/xmldom": ">=0.8.13"
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.4.0",
    "react-email": "^5.2.9",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
